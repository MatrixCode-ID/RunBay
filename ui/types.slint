// Data passed between Rust and the UI.

// A styled piece of an output line.
export struct Span {
    text: string,
    color: color,
    dark-color: color,
    colored: bool,
    bold: bool,
}

// One output line.
export struct OutputRow {
    run-index: int,
    plain-text: string,
    selected-from: int,
    selected-to: int,
    spans: [Span],
    stderr: bool,
}

// An action button of an app.
export struct ActionButton {
    id: string,
    name: string,
    kind: string,
    icon-name: string,
    // A custom image replaces the Material Symbol and keeps its own colors.
    image: image,
    has-image: bool,
    enabled: bool,
    // "running" while one of its runs is active, otherwise "".
    status: string,
    // The active step is Build or Custom; Run uses a steady lamp instead.
    busy: bool,
    // The active run was started by an agent.
    agent: bool,
}

// A run listed below its app in the navigation, or in a tab strip.
export struct RunRow {
    run-id: string,
    title: string,
    status: string,
    busy: bool,
    agent: string,
    time: string,
    // Final duration of a finished run; empty while running.
    duration: string,
    // Start in Clock seconds, for the live elapsed time while running.
    started: int,
    selected: bool,
}

// Seconds since RunBay started, advanced once a second only while runs are active, so
// running rows show a live elapsed time without rebuilding their models.
export global Clock {
    in-out property <int> now;

    // `12 s`, `4 min 05 s`, `1 h 02 min`.
    public pure function elapsed(seconds: int) -> string {
        if (seconds < 60) {
            return max(0, seconds) + " s";
        }
        if (seconds < 3600) {
            return floor(seconds / 60) + " min " + (mod(seconds, 60) < 10 ? "0" : "") + mod(seconds, 60) + " s";
        }
        return floor(seconds / 3600) + " h " + (mod(floor(seconds / 60), 60) < 10 ? "0" : "") + mod(floor(seconds / 60), 60) + " min";
    }

    // Live elapsed time while running, otherwise the final duration.
    public pure function duration(status: string, started: int, final: string) -> string {
        return status == "running" ? elapsed(Clock.now - started) : final;
    }
}

// An app card in the navigation.
export struct AppRow {
    id: string,
    name: string,
    initial: string,
    icon: image,
    has-icon: bool,
    // Name of the group when this app is the first of its group, otherwise "".
    group-header: string,
    group-id: string,
    status: string,
    status-agent: bool,
    status-busy: bool,
    status-detail: string,
    agent: string,
    error: string,
    actions: [ActionButton],
    runs: [RunRow],
}

// Shared state for icon-only reordering inside an app list.
export global AppDrag {
    in-out property <string> source;
    in-out property <string> group;
    in-out property <string> target;
    in-out property <bool> after;
    in-out property <length> pointer-x;
    in-out property <length> pointer-y;
    in-out property <length> viewport-top;
    in-out property <length> viewport-bottom;
    callback reordered(string, string, bool);
    public function cancel() { source = ""; target = ""; }
    public function finish() {
        let from = source;
        let to = target;
        let insert-after = after;
        cancel();
        if from != "" && to != "" && from != to { reordered(from, to, insert-after); }
    }
}
