// Compact mode (small app list window) and Icon mode (floating round icon with a popup).

import { ListView, Palette } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { ActionBar, SymbolButton, StatusBadge, AgentChip, Avatar, OutputView, OutputBridge, ConsoleThemeButton } from "components.slint";
import { Span, OutputRow, ActionButton, RunRow, AppRow, Clock } from "types.slint";

// Data and callbacks shared by the Compact window and the Icon popup.
export global MiniBridge {
    in-out property <[AppRow]> apps;
    in-out property <[OutputRow]> output;
    in-out property <int> output-columns;
    in-out property <string> output-title;
    in-out property <string> output-status;
    in-out property <string> output-duration;
    in-out property <int> output-started;
    in-out property <bool> output-busy;
    in-out property <string> output-agent;
    in-out property <string> output-run-id;
    in-out property <string> version;
    in-out property <string> update-badge;
    in-out property <string> agents;
    in-out property <string> snackbar;
    in-out property <bool> snackbar-undo;
    callback run-action(string, string);
    callback open-output(string);
    callback stop-run(string);
    callback stop-app(string);
    callback open-in-full(string);
    callback switch-mode(string);
    callback version-clicked();
    callback undo-clicked();
    callback copy-mcp-setup();
}

// The live output of an app's last run, with Stop and Open in Full.
component OutputCard inherits Rectangle {
    border-radius: Theme.corner-large;
    background: Theme.surface-container-high;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000055;
    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: MiniBridge.output-title == "" ? "No runs yet" : MiniBridge.output-title;
                color: Theme.on-surface;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if Clock.duration(MiniBridge.output-status, MiniBridge.output-started, MiniBridge.output-duration) != "": Text {
                text: Clock.duration(MiniBridge.output-status, MiniBridge.output-started, MiniBridge.output-duration);
                color: Theme.on-surface-variant;
                font-size: Theme.label-medium;
                vertical-alignment: center;
            }
            StatusBadge {
                status: MiniBridge.output-status;
                busy: MiniBridge.output-busy;
                agent: MiniBridge.output-agent != "";
                y: (parent.height - self.height) / 2;
            }
            SymbolButton {
                icon: Icons.stop;
                tooltip: "Stop";
                size: 30px;
                enabled: MiniBridge.output-status == "running";
                clicked => { MiniBridge.stop-run(MiniBridge.output-run-id); }
            }
            SymbolButton {
                icon: Icons.open-full;
                tooltip: "Open in Full";
                size: 30px;
                clicked => { MiniBridge.open-in-full(MiniBridge.output-run-id); }
            }
            ConsoleThemeButton { size: 30px; }
        }
        if MiniBridge.output-agent != "": AgentChip { agent: MiniBridge.output-agent; }
        Rectangle {
            background: Theme.console-background;
            border-radius: Theme.corner-medium;
            clip: true;
            OutputView {
                rows: MiniBridge.output;
                columns: MiniBridge.output-columns;
                popup: true;
                generation: OutputBridge.popup-generation;
                font-size: 12px;
                row-height: 16px;
                side-padding: 8px;
            }
        }
    }
}

// One app row: icon, name, badge, action icons with overflow menu, and message icon.
component MiniAppRow inherits Rectangle {
    in property <AppRow> app;
    callback show-output(string);
    height: 70px;
    border-radius: Theme.corner-medium;
    background: touch.has-hover ? Theme.surface-container-high : transparent;
    touch := TouchArea { }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 8px;
        Avatar {
            icon: app.icon;
            has-icon: app.has-icon;
            initial: app.initial;
            size: 32px;
            y: 8px;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            padding-top: 6px;
            padding-bottom: 4px;
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: app.name;
                    color: Theme.on-surface;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                StatusBadge {
                    status: app.status;
                    busy: app.status-busy;
                    agent: app.status-agent;
                    tooltip: app.status-detail;
                    size: 16px;
                    y: (parent.height - self.height) / 2;
                }
            }
            if app.error != "": Text {
                text: "Cannot be loaded";
                color: Theme.error;
                font-size: Theme.label-small;
            }
            if app.error == "": HorizontalLayout {
                spacing: 2px;
                alignment: stretch;
                ActionBar {
                    actions: app.actions;
                    size: 30px;
                    style: "standard";
                    triggered(id) => { MiniBridge.run-action(app.id, id); }
                }
                if app.status == "running": SymbolButton {
                    icon: Icons.stop;
                    tooltip: "Stop all active actions for " + app.name;
                    size: 30px;
                    icon-size: 18px;
                    icon-color: Theme.error;
                    clicked => { MiniBridge.stop-app(app.id); }
                }
                SymbolButton {
                    icon: app.status == "running" ? Icons.chat-fill : Icons.chat;
                    tooltip: "Last output";
                    size: 30px;
                    icon-size: 18px;
                    clicked => { root.show-output(app.id); }
                }
            }
        }
    }

}

// The app list with its output popup, used by Compact mode and the Icon popup.
component AppList inherits Rectangle {
    ListView {
        for app in MiniBridge.apps: MiniAppRow {
            app: app;
            show-output(id) => {
                MiniBridge.open-output(id);
                output-popup.show();
            }
        }
    }
    output-popup := PopupWindow {
        x: 6px;
        y: 40px;
        width: root.width - 12px;
        height: min(320px, root.height - 48px);
        close-policy: close-on-click-outside;
        OutputCard { }
    }
}

component Snackbar inherits Rectangle {
    visible: MiniBridge.snackbar != "";
    height: MiniBridge.snackbar == "" ? 0 : 44px;
    border-radius: Theme.corner-small;
    background: Theme.inverse-surface;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 6px;
        Text {
            text: MiniBridge.snackbar;
            color: Theme.inverse-on-surface;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if MiniBridge.snackbar-undo: Rectangle {
            width: undo-label.preferred-width + 16px;
            undo-label := Text {
                text: "Undo";
                color: Theme.inverse-primary;
                font-weight: 600;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { MiniBridge.undo-clicked(); }
            }
        }
    }
}

component McpSetupShortcut inherits Rectangle {
    height: 28px;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: start;
        SymbolButton {
            icon: Icons.copy;
            label: "Copy MCP setup";
            tooltip: "Copy MCP setup instructions";
            size: 28px;
            clicked => { MiniBridge.copy-mcp-setup(); }
        }
    }
}

export component CompactWindow inherits Window {
    public function set-theme(mode: int) {
        Palette.color-scheme = mode == 1 ? ColorScheme.light : mode == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    title: "RunBay";
    icon: @image-url("logo/runbay-64.png");
    preferred-width: 360px;
    preferred-height: 420px;
    min-width: 360px;
    min-height: 200px;
    background: Theme.surface-container;
    in property <bool> pinned;
    always-on-top: pinned;
    callback toggle-pin();
    in property <int> theme-mode;
    callback cycle-theme();

    in property <bool> window-active: true;
    in property <bool> window-maximized;
    in property <bool> max-hover;
    in property <bool> max-pressed;
    out property <length> caption-height: header.height;
    out property <length> drag-end: controls.x;
    callback caption-minimize();
    callback caption-close();
    callback caption-metrics-changed();
    changed caption-height => { root.caption-metrics-changed(); }
    changed drag-end => { root.caption-metrics-changed(); }

    VerticalLayout {
        header := HorizontalLayout {
            padding: 8px;
            spacing: 2px;
            Image {
                source: Icons.logo;
                width: 22px;
                height: 22px;
                y: (parent.height - self.height) / 2;
                opacity: root.window-active ? 1 : 0.55;
            }
            Text {
                text: "RunBay";
                color: Theme.on-surface-variant;
                opacity: root.window-active ? 1 : 0.55;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            controls := HorizontalLayout {
            spacing: 2px;
            if MiniBridge.agents != "": Rectangle {
                width: 18px;
                Image {
                source: Icons.agent;
                width: 18px;
                colorize: Theme.tertiary;
                y: (parent.height - self.height) / 2;
                }
                accessible-role: text;
                accessible-label: "Connected agents: " + MiniBridge.agents;
                Tooltip {
                    Text { text: "Connected agents: " + MiniBridge.agents; }
                }
            }
            SymbolButton {
                icon: root.theme-mode == 1 ? Icons.light-mode : root.theme-mode == 2 ? Icons.dark-mode : Icons.system-theme;
                tooltip: root.theme-mode == 1 ? "Theme: Light. Click for Dark."
                    : root.theme-mode == 2 ? "Theme: Dark. Click for System."
                    : "Theme: System (" + (Theme.dark ? "Dark" : "Light") + "). Click for Light.";
                window-active: root.window-active;
                size: 32px;
                clicked => { root.cycle-theme(); }
            }
            SymbolButton {
                icon: pinned ? Icons.pin-fill : Icons.pin;
                tooltip: pinned ? "Always on top: on" : "Always on top: off";
                window-active: root.window-active;
                style: pinned ? "tonal" : "standard";
                size: 32px;
                clicked => { root.toggle-pin(); }
            }
            SymbolButton {
                icon: Icons.bubble;
                tooltip: "Icon mode";
                window-active: root.window-active;
                size: 32px;
                clicked => { MiniBridge.switch-mode("icon"); }
            }
            SymbolButton {
                icon: Icons.full;
                tooltip: "Full mode";
                window-active: root.window-active;
                size: 32px;
                clicked => { MiniBridge.switch-mode("full"); }
            }
            SymbolButton {
                icon: Icons.minimize;
                tooltip: "Minimize";
                size: 32px;
                window-active: root.window-active;
                clicked => { root.caption-minimize(); }
            }
            SymbolButton {
                icon: Icons.close;
                tooltip: "Close";
                danger: true;
                size: 32px;
                window-active: root.window-active;
                clicked => { root.caption-close(); }
            }
            }
        }
        AppList {
            vertical-stretch: 1;
        }
        McpSetupShortcut { }
        Snackbar { }
        Rectangle {
            height: 28px;
            footer-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { MiniBridge.version-clicked(); }
            }
            HorizontalLayout {
                padding-left: 10px;
                spacing: 6px;
                alignment: start;
                Text {
                    text: "RunBay " + MiniBridge.version;
                    color: footer-touch.has-hover ? Theme.primary : Theme.on-surface-variant;
                    font-size: Theme.label-small;
                    vertical-alignment: center;
                }
                if MiniBridge.update-badge != "": Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 18px;
                    width: compact-badge.preferred-width + 12px;
                    border-radius: 9px;
                    background: Theme.tertiary-container;
                    compact-badge := Text {
                        text: MiniBridge.update-badge;
                        color: Theme.on-tertiary-container;
                        font-size: Theme.label-small;
                    }
                }
            }
        }
    }
}

export component IconWindow inherits Window {
    public function set-theme(mode: int) {
        Palette.color-scheme = mode == 1 ? ColorScheme.light : mode == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    title: "RunBay";
    icon: @image-url("logo/runbay-64.png");
    no-frame: true;
    background: transparent;
    in property <length> size: 56px;
    in property <bool> pinned: true;
    in property <string> status;
    in property <bool> status-agent;
    in property <bool> status-busy;
    always-on-top: pinned;
    width: size;
    height: size;
    callback pressed();
    callback clicked();
    callback right-clicked();

    WindowMoveArea {
        Rectangle {
            border-radius: self.width / 2;
            background: Theme.primary-container;
            Image {
                source: Icons.logo;
                width: parent.width * 0.72;
                height: parent.height * 0.72;
            }
            TouchArea {
                mouse-cursor: pointer;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        root.pressed();
                    }
                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                        root.right-clicked();
                    }
                }
                clicked => { root.clicked(); }
            }
        }
        if status != "": Rectangle {
            x: parent.width - self.width;
            y: parent.height - self.height;
            width: max(16px, size * 0.32);
            height: self.width;
            border-radius: self.width / 2;
            background: Theme.surface;
            StatusBadge {
                status: status;
                busy: status-busy;
                agent: status-agent;
                size: parent.width - 2px;
            }
        }
        if MiniBridge.agents != "": Rectangle {
            x: parent.width - self.width;
            y: 0px;
            width: max(10px, size * 0.2);
            height: self.width;
            border-radius: self.width / 2;
            background: Theme.success;
            border-width: 2px;
            border-color: Theme.surface;
        }
    }
}

// The window next to the floating icon: app cards ("apps"), the right-click menu
// ("menu"), or a snackbar for agent changes ("snackbar").
export component IconPopup inherits Window {
    public function set-theme(mode: int) {
        Palette.color-scheme = mode == 1 ? ColorScheme.light : mode == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    title: "RunBay";
    no-frame: true;
    background: transparent;
    always-on-top: true;
    in property <string> view: "apps";
    in property <bool> pinned;
    callback menu-action(string);
    callback dismissed();
    width: view == "apps" ? 320px : view == "menu" ? 250px : 300px;
    height: view == "apps" ? 420px : view == "menu" ? 8 * 34px + 16px : 60px;

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismissed();
                return accept;
            }
            return reject;
        }
        Rectangle {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: parent.height - 8px;
            border-radius: Theme.corner-large;
            background: view == "snackbar" ? Theme.inverse-surface : Theme.surface-container;
            border-width: 1px;
            border-color: Theme.outline-variant;
            clip: true;
            if view == "apps": VerticalLayout {
                padding: 6px;
                AppList {
                    vertical-stretch: 1;
                }
                McpSetupShortcut { }
                Snackbar { }
            }
            if view == "snackbar": VerticalLayout {
                padding: 4px;
                Snackbar { }
            }
            if view == "menu": VerticalLayout {
                padding: 6px;
                for item in [
                    { id: "full", text: "Full mode" },
                    { id: "compact", text: "Compact mode" },
                    { id: "pin", text: pinned ? "Always on top  ✓" : "Always on top" },
                    { id: "small", text: "Icon size: small" },
                    { id: "medium", text: "Icon size: medium" },
                    { id: "large", text: "Icon size: large" },
                    { id: "copy-mcp-setup", text: "Copy MCP setup instructions" },
                    { id: "exit", text: "Exit" },
                ]: Rectangle {
                    height: 34px;
                    background: menu-touch.has-hover ? Theme.surface-container-highest : transparent;
                    border-radius: 6px;
                    Text {
                        x: 12px;
                        text: item.text;
                        color: item.id == "exit" ? Theme.error : Theme.on-surface;
                        vertical-alignment: center;
                    }
                    menu-touch := TouchArea {
                        clicked => { root.menu-action(item.id); }
                    }
                }
            }
        }
    }
}
