// Shared building blocks: icon buttons, status badges, chips, avatars, and dialogs.

import { Theme, Icons } from "theme.slint";
import { ListView } from "std-widgets.slint";
import { OutputRow, ActionButton, AppDrag } from "types.slint";

// Shared keyboard focus indicator. List rows use an inward offset of -3px.
export component FocusRing inherits Rectangle {
    in property <bool> active;
    in property <length> radius;
    in property <length> offset: Theme.focus-offset;
    x: -offset;
    y: -offset;
    border-radius: max(0px, radius + offset);
    border-width: Theme.focus-thickness;
    border-color: Theme.secondary;
    background: transparent;
    opacity: active ? 1 : 0;
    animate opacity {
        duration: Theme.motion-fast;
        easing: ease-out;
    }
}
// Standard-color M3 Expressive vertical menus, shared by actions and selectors.
export component MenuSurface inherits Rectangle {
    in property <length> item-spacing: 2px;
    // Forward the layout height through the focus scope to the popup's hit bounds.
    min-height: menu-layout.min-height;
    preferred-height: menu-layout.preferred-height;
    border-radius: Theme.corner-large;
    background: Theme.surface-container-low;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: #00000040;
    callback dismissed();
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.dismissed(); return accept; }
            return reject;
        }
        menu-layout := VerticalLayout {
            padding: 2px;
            spacing: root.item-spacing;
            alignment: start;
            @children
        }
    }
}

export component MenuEntry inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: true;
    in property <bool> colorize-icon: true;
    in property <bool> danger;
    in property <bool> selected;
    in property <bool> checkable;
    in property <bool> highlighted;
    in property <bool> first;
    in property <bool> last;
    in property <bool> enabled: true;
    callback clicked();
    height: 48px;
    min-width: 112px;
    vertical-stretch: 0;
    border-top-left-radius: selected || first ? 12px : 4px;
    border-top-right-radius: self.border-top-left-radius;
    border-bottom-left-radius: selected || last ? 12px : 4px;
    border-bottom-right-radius: self.border-bottom-left-radius;
    background: selected ? Theme.tertiary-container : transparent;
    property <color> foreground: selected ? Theme.on-tertiary-container : danger ? Theme.error : Theme.on-surface;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-checkable: checkable;
    accessible-checked: selected;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: keys;
    Rectangle {
        border-radius: parent.border-radius;
        border-top-left-radius: root.border-top-left-radius;
        border-top-right-radius: root.border-top-right-radius;
        border-bottom-left-radius: root.border-bottom-left-radius;
        border-bottom-right-radius: root.border-bottom-right-radius;
        background: root.foreground.with-alpha(!root.enabled ? 0 : touch.pressed ? 0.12
            : keys.has-focus || root.highlighted ? 0.1 : touch.has-hover ? 0.08 : 0);
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        opacity: root.enabled ? 1 : 0.38;
        if root.has-icon: Image {
            source: root.icon;
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            colorize: !root.colorize-icon ? transparent : root.selected || root.danger ? root.foreground : Theme.on-surface-variant;
        }
        Text {
            text: root.text;
            color: root.foreground;
            font-size: Theme.label-large;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.selected: Image {
            source: Icons.check;
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            colorize: root.foreground;
        }
        @children
    }
    FocusRing {
        width: parent.width + 2 * self.offset;
        height: parent.height + 2 * self.offset;
        active: keys.has-focus || root.highlighted;
        radius: 12px;
        offset: -3px;
    }
    keys := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// An outlined selector whose popup uses the same Expressive menu as app actions.
export component Dropdown inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index;
    out property <string> current-value: current-index >= 0 && current-index < model.length ? model[current-index] : "";
    in property <bool> enabled: true;
    in property <length> menu-width: max(root.width, 240px);
    property <int> active-index;
    property <bool> keyboard-open;
    // Popup visibility also covers automatic dismissal without a focus event.
    out property <bool> expanded: menu.is-open;
    property <length> popup-scroll-y;
    callback selected(string);
    height: 48px;
    min-width: 64px;
    preferred-width: 200px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: Theme.corner-extra-small;
    border-width: keys.has-focus || expanded ? 2px : 1px;
    border-color: keys.has-focus || expanded ? Theme.primary : Theme.outline;
    opacity: enabled ? 1 : 0.38;
    accessible-role: combobox;
    accessible-enabled: enabled;
    accessible-value: current-value;
    accessible-expandable: true;
    accessible-expanded: expanded;
    accessible-action-expand => { root.open(false); }
    forward-focus: keys;

    changed model => { current-index = clamp(current-index, 0, max(0, model.length - 1)); }

    function open(keyboard: bool) {
        if enabled && model.length > 0 {
            active-index = clamp(current-index, 0, model.length - 1);
            keyboard-open = keyboard;
            popup-scroll-y = -max(0, active-index - 5) * 50px;
            menu.show();
        }
    }
    function dismiss() { menu.close(); if keyboard-open { keys.focus(); } }
    function choose(index: int) {
        if enabled && index >= 0 && index < model.length {
            current-index = index;
            root.selected(model[index]);
            root.dismiss();
        }
    }
    function move(delta: int) {
        keyboard-open = true;
        active-index = clamp(active-index + delta, 0, model.length - 1);
        if active-index * 50px + popup-scroll-y < 0px {
            popup-scroll-y = -active-index * 50px;
        } else if (active-index + 1) * 50px + popup-scroll-y > min(6, model.length) * 50px - 2px {
            popup-scroll-y = min(6, model.length) * 50px - 2px - (active-index + 1) * 50px;
        }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 8px;
        Text {
            text: root.current-value;
            color: Theme.on-surface;
            font-size: Theme.body-large;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Image {
            source: Icons.expand-more;
            width: 24px;
            height: 24px;
            y: (parent.height - self.height) / 2;
            colorize: Theme.on-surface-variant;
            transform-rotation: root.expanded ? 180deg : 0deg;
            animate transform-rotation { duration: Theme.motion-fast; }
        }
    }
    FocusRing {
        width: parent.width + 2 * self.offset;
        height: parent.height + 2 * self.offset;
        active: keys.has-focus;
        radius: root.border-radius;
    }
    keys := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space || event.text == Key.DownArrow || event.text == Key.UpArrow {
                root.open(true); return accept;
            }
            return reject;
        }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.open(false); }
    }
    menu := PopupWindow {
        y: root.height + 4px;
        width: root.menu-width;
        height: min(6, root.model.length) * 50px + 2px;
        close-policy: close-on-click-outside;
        forward-focus: menu-keys;
        MenuSurface {
            dismissed => { root.dismiss(); }
        }
        menu-keys := FocusScope {
            key-pressed(event) => {
                if event.text == Key.DownArrow { root.move(1); return accept; }
                if event.text == Key.UpArrow { root.move(-1); return accept; }
                if event.text == Key.Home { root.move(-root.model.length); return accept; }
                if event.text == Key.End { root.move(root.model.length); return accept; }
                if event.text == Key.Return || event.text == Key.Space { root.choose(root.active-index); return accept; }
                if event.text == Key.Escape { root.dismiss(); return accept; }
                if event.text == Key.Tab { root.dismiss(); return reject; }
                return reject;
            }
            choices := Flickable {
                x: 2px;
                y: 2px;
                width: parent.width - 4px;
                height: parent.height - 4px;
                content-width: self.width;
                content-y <=> root.popup-scroll-y;
                interactive: root.model.length > 6;
                VerticalLayout {
                    spacing: 2px;
                    for value[index] in root.model: MenuEntry {
                        text: value;
                        has-icon: false;
                        selected: index == root.current-index;
                        checkable: true;
                        highlighted: root.keyboard-open && index == root.active-index;
                        first: index == 0;
                        last: index == root.model.length - 1;
                        clicked => { root.choose(index); }
                    }
                }
            }
        }
    }
}

export component FilterChip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 32px;
    width: content.preferred-width;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.corner-small;
    border-width: selected ? 0px : 1px;
    border-color: Theme.outline-variant;
    background: selected ? Theme.secondary-container : transparent;
    animate background {
        duration: Theme.motion-fast;
        easing: ease-out;
    }
    forward-focus: keys;
    accessible-role: button;
    accessible-label: text;
    accessible-checkable: true;
    accessible-checked: selected;
    accessible-action-default => {
        root.clicked();
    }
    Rectangle {
        border-radius: parent.border-radius;
        background: Theme.on-surface.with-alpha(touch.pressed || keys.has-focus ? 0.12 : touch.has-hover ? 0.08 : 0);
    }
    content := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        if root.selected: Image {
            source: Icons.check;
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            colorize: Theme.on-secondary-container;
        }
        Text {
            text: root.text;
            font-size: Theme.label-large;
            font-weight: 500;
            color: root.selected ? Theme.on-secondary-container : Theme.on-surface-variant;
            vertical-alignment: center;
        }
    }
    FocusRing {
        width: parent.width + 2 * self.offset;
        height: parent.height + 2 * self.offset;
        active: keys.has-focus;
        radius: root.border-radius;
    }
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}
// Single selection with expressive inner corners; indices belong to the caller.
export component ConnectedButtonGroup inherits HorizontalLayout {
    in property <[string]> labels;
    in-out property <int> selected-index;
    callback selected();
    spacing: 2px;
    height: 40px;
    vertical-stretch: 0;
    for label[index] in labels: Rectangle {
        height: 40px;
        min-width: caption.preferred-width + 24px;
        border-top-left-radius: index == 0 || index == root.selected-index ? 20px : Theme.corner-small;
        border-bottom-left-radius: self.border-top-left-radius;
        border-top-right-radius: index == root.labels.length - 1 || index == root.selected-index ? 20px : Theme.corner-small;
        border-bottom-right-radius: self.border-top-right-radius;
        background: index == root.selected-index ? Theme.secondary-container : Theme.surface-container-high;
        animate border-top-left-radius, border-bottom-left-radius, border-top-right-radius, border-bottom-right-radius {
            duration: Theme.motion-fast;
            easing: ease-out-back;
        }
        animate background {
            duration: Theme.motion-fast;
            easing: ease-out;
        }
        forward-focus: keys;
        accessible-role: button;
        accessible-label: label;
        accessible-checkable: true;
        accessible-checked: index == root.selected-index;
        accessible-action-default => {
            root.selected-index = index;
            root.selected();
        }
        Rectangle {
            border-top-left-radius: parent.border-top-left-radius;
            border-bottom-left-radius: parent.border-bottom-left-radius;
            border-top-right-radius: parent.border-top-right-radius;
            border-bottom-right-radius: parent.border-bottom-right-radius;
            background: Theme.on-surface.with-alpha(touch.pressed || keys.has-focus ? 0.12 : touch.has-hover ? 0.08 : 0);
        }
        caption := Text {
            text: label;
            font-size: Theme.label-large;
            font-weight: 500;
            color: index == root.selected-index ? Theme.on-secondary-container : Theme.on-surface-variant;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        FocusRing {
            width: parent.width + 2 * self.offset;
            height: parent.height + 2 * self.offset;
            active: keys.has-focus;
            border-top-left-radius: parent.border-top-left-radius + self.offset;
            border-bottom-left-radius: parent.border-bottom-left-radius + self.offset;
            border-top-right-radius: parent.border-top-right-radius + self.offset;
            border-bottom-right-radius: parent.border-bottom-right-radius + self.offset;
        }
        keys := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Return || event.text == Key.Space {
                    root.selected-index = index;
                    root.selected();
                    return accept;
                }
                return reject;
            }
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.selected-index = index;
                root.selected();
            }
        }
    }
}
// Outer corners are provided by the first and last item, preserving their gaps.
export component SegmentedList inherits VerticalLayout {
    spacing: 2px;
    alignment: start;
    @children
}
export component ListItem inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> first;
    in property <bool> last;
    in property <bool> narrow: self.width < 480px;
    min-height: max(hint == "" ? 48px : 64px, narrow ? labels.preferred-height + controls.preferred-height + 24px : max(labels.preferred-height, controls.preferred-height) + 16px);
    vertical-stretch: 0;
    background: Theme.surface;
    border-top-left-radius: first ? Theme.corner-large : Theme.corner-extra-small;
    border-top-right-radius: self.border-top-left-radius;
    border-bottom-left-radius: last ? Theme.corner-large : Theme.corner-extra-small;
    border-bottom-right-radius: self.border-bottom-left-radius;
    labels := VerticalLayout {
        x: 16px;
        y: root.narrow ? 12px : (root.height - self.preferred-height) / 2;
        width: root.narrow ? root.width - 32px : max(0px, controls.x - 32px);
        height: self.preferred-height;
        spacing: 4px;
        Text {
            text: root.label;
            color: Theme.on-surface;
            font-size: Theme.body-large;
            wrap: word-wrap;
        }
        if root.hint != "": Text {
            text: root.hint;
            color: Theme.on-surface-variant;
            font-size: Theme.body-small;
            wrap: word-wrap;
        }
    }
    controls := HorizontalLayout {
        x: root.narrow ? 16px : root.width - self.width - 16px;
        y: root.narrow ? labels.y + labels.height + 8px : (root.height - self.height) / 2;
        width: min(self.preferred-width, root.width - 32px);
        height: self.preferred-height;
        spacing: 8px;
        alignment: start;
        @children
    }
}
// Keyboard handling for navigation and list entries without mouse focus theft.
export component KeyboardRow inherits Rectangle {
    in property <bool> focus-request;
    callback activated();
    callback moved(int);
    forward-focus: keys;
    accessible-role: button;
    accessible-action-default => {
        root.activated();
    }
    changed focus-request => {
        if focus-request {
            keys.focus();
        }
    }
    @children
    FocusRing {
        width: parent.width + 2 * self.offset;
        height: parent.height + 2 * self.offset;
        active: keys.has-focus;
        radius: root.border-radius;
        offset: -3px;
    }
    keys := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.activated();
                return accept;
            }
            if event.text == Key.UpArrow {
                root.moved(-1);
                return accept;
            }
            if event.text == Key.DownArrow {
                root.moved(1);
                return accept;
            }
            return reject;
        }
    }
}
// Density -2 outlined field. No clear affordance, including numeric retention.
export component TextField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text;
    in property <InputType> input-type <=> input.input-type;
    in property <bool> enabled: true;
    callback edited(string);
    height: 48px;
    min-width: 64px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: Theme.corner-extra-small;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.primary : Theme.outline;
    opacity: enabled ? 1 : 0.38;
    background: transparent;
    forward-focus: input;
    Text {
        x: 16px;
        width: parent.width - 32px;
        height: parent.height;
        text: input.text == "" ? root.placeholder-text : "";
        font-size: Theme.body-large;
        color: Theme.on-surface-variant;
        vertical-alignment: center;
        overflow: elide;
    }
    ContextMenuArea {
        x: 16px;
        width: parent.width - 32px;
        height: parent.height;
        enabled: root.enabled;
        Menu {
            MenuItem {
                title: "Undo";
                activated => {
                    input.undo();
                }
            }
            MenuItem {
                title: "Redo";
                activated => {
                    input.redo();
                }
            }
            MenuSeparator {
            }
            MenuItem {
                title: "Cut";
                activated => {
                    input.cut();
                }
            }
            MenuItem {
                title: "Copy";
                activated => {
                    input.copy();
                }
            }
            MenuItem {
                title: "Paste";
                activated => {
                    input.paste();
                }
            }
            MenuItem {
                title: "Select all";
                activated => {
                    input.select-all();
                }
            }
        }
        field-viewport := Rectangle {
            clip: true;
            input := TextInput {
                property <length> scroll-x;
                x: clamp(scroll-x, min(0px, field-viewport.width - self.width), 0px);
                width: max(field-viewport.width, self.preferred-width + self.text-cursor-width);
                height: parent.height;
                cursor-position-changed(position) => {
                    if position.x + self.x < 0px {
                        scroll-x = -position.x;
                    }
                    if position.x + self.x > field-viewport.width - self.text-cursor-width {
                        scroll-x = field-viewport.width - self.text-cursor-width - position.x;
                    }
                }
                enabled: root.enabled;
                single-line: true;
                font-size: Theme.body-large;
                color: Theme.on-surface;
                selection-background-color: Theme.secondary-container;
                selection-foreground-color: Theme.on-secondary-container;
                vertical-alignment: center;
                accessible-placeholder-text: root.placeholder-text;
                edited => {
                    root.edited(self.text);
                }
            }
        }
    }
}

// M3 switch colors use the same roles as the rest of RunBay, independent of
// the operating system accent. The selected thumb contrasts with its track.
export component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled();
    width: 52px;
    height: 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 16px;
    border-width: 2px;
    border-color: checked ? Theme.primary : Theme.outline;
    background: checked ? Theme.primary : Theme.surface-container-highest;
    opacity: enabled ? 1 : 0.38;
    forward-focus: keys;
    accessible-role: switch;
    accessible-enabled: enabled;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-action-default => { root.toggle(); }

    function toggle() {
        if root.enabled {
            root.checked = !root.checked;
            root.toggled();
        }
    }

    Rectangle {
        width: touch.pressed ? 28px : root.checked ? 24px : 16px;
        height: self.width;
        x: root.checked ? parent.width - self.width - 4px : (32px - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: root.checked ? Theme.on-primary : Theme.outline;
        Rectangle {
            width: 40px;
            height: 40px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 20px;
            background: (root.checked ? Theme.primary : Theme.on-surface).with-alpha(
                touch.pressed || keys.has-focus ? 0.12 : touch.has-hover ? 0.08 : 0);
        }
        animate x, width, background { duration: Theme.motion-fast; }
    }
    FocusRing {
        width: parent.width + 2 * self.offset;
        height: parent.height + 2 * self.offset;
        active: keys.has-focus;
        radius: root.border-radius;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggle(); }
    }
    keys := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.toggle();
                return accept;
            }
            return reject;
        }
    }
}

// One protocol for the Full output and the Compact/Icon output popups.
export global OutputBridge {
    callback cycle-console-theme();
    callback selection-event(bool, string, int, int, bool);
    in-out property <bool> full-selected;
    in-out property <bool> popup-selected;
    in-out property <int> full-focus: -1;
    in-out property <int> popup-focus: -1;
    in-out property <int> popup-generation;
}

// Virtualized ANSI spans, with selection drawn behind their original colors.
export component OutputView inherits Rectangle {
    in property <[OutputRow]> rows;
    in property <int> columns;
    in property <bool> popup;
    in property <int> generation;
    in property <length> font-size: 13px;
    in property <length> row-height: 18px;
    in property <length> side-padding: 12px;
    property <bool> follow: true;
    property <bool> dragging;
    property <int> pressed-row;
    property <int> pressed-column;
    property <bool> selected: popup ? OutputBridge.popup-selected : OutputBridge.full-selected;
    property <int> focus-row: popup ? OutputBridge.popup-focus : OutputBridge.full-focus;
    property <length> char-width: max(1px, measure.preferred-width);
    property <bool> horizontal-overflow: columns * char-width + 2 * side-padding > list.visible-width;
    forward-focus: keys;
    clip: true;

    callback selection-start(int, int, bool);
    callback selection-extend(int, int);
    callback selection-word(int, int);
    callback selection-line(int, int);
    callback selection-key(string);
    callback selection-clear();
    callback copy-selection();
    callback select-all();
    selection-start(row, column, shift) => { OutputBridge.selection-event(popup, "start", row, column, shift); }
    selection-extend(row, column) => { OutputBridge.selection-event(popup, "extend", row, column, false); }
    selection-word(row, column) => { OutputBridge.selection-event(popup, "word", row, column, false); }
    selection-line(row, column) => { OutputBridge.selection-event(popup, "line", row, column, false); }
    selection-key(key) => { OutputBridge.selection-event(popup, key, 0, 0, false); root.reveal-focus(); }
    selection-clear => { OutputBridge.selection-event(popup, "clear", 0, 0, false); }
    copy-selection => { OutputBridge.selection-event(popup, "copy", 0, 0, false); }
    select-all => { OutputBridge.selection-event(popup, "all", 0, 0, false); }

    pure function row-at-pointer() -> int {
        return clamp(floor((touch.mouse-y - list.content-y) / row-height), 0, max(0, rows.length - 1));
    }
    pure function column-at-pointer() -> int {
        return max(0, floor((touch.mouse-x - list.content-x - side-padding) / char-width));
    }
    public function scroll-to-end() {
        follow = true;
        list.content-y = min(0px, list.visible-height - list.content-height);
        list.content-x = 0px;
    }
    function reveal-focus() {
        if focus-row >= 0 {
            if focus-row * row-height + list.content-y < 0px {
                list.content-y = -focus-row * row-height;
            } else if (focus-row + 1) * row-height + list.content-y > list.visible-height {
                list.content-y = min(0px, list.visible-height - (focus-row + 1) * row-height);
            }
        }
    }
    changed generation => { dragging = false; root.scroll-to-end(); }
    changed selected => {
        if selected { follow = false; }
        else { follow = list.content-y <= list.visible-height - list.content-height + 4px; }
    }

    measure := Text {
        visible: false;
        text: "M";
        font-family: Theme.mono-font;
        font-size: root.font-size;
    }
    list := ListView {
        height: root.height - (root.horizontal-overflow ? 20px : 0px);
        horizontal-scrollbar-policy: always-off;
        content-width: max(self.visible-width, root.columns * root.char-width + 2 * root.side-padding);
        for row in root.rows: Rectangle {
            height: root.row-height;
            Rectangle {
                x: root.side-padding + max(0, row.selected-from) * root.char-width;
                width: max(0, row.selected-to - row.selected-from) * root.char-width;
                height: parent.height;
                visible: row.selected-from >= 0;
                background: Theme.console-selection;
            }
            HorizontalLayout {
                alignment: start;
                padding-left: root.side-padding;
                padding-right: root.side-padding;
                for span in row.spans: Text {
                    text: span.text;
                    color: span.colored ? (Theme.console-dark ? span.dark-color : span.color)
                        : row.stderr ? Theme.console-error : Theme.console-text;
                    font-family: Theme.mono-font;
                    font-size: root.font-size;
                    font-weight: span.bold ? 700 : 400;
                    wrap: no-wrap;
                    vertical-alignment: center;
                }
            }
        }
        changed content-height => {
            if root.follow && !root.selected && !root.dragging {
                self.content-y = min(0px, self.visible-height - self.content-height);
            }
        }
        changed content-y => {
            root.follow = !root.selected && !root.dragging && self.content-y <= self.visible-height - self.content-height + 4px;
        }
    }
    keys := FocusScope {
        width: list.visible-width;
        height: list.visible-height;
        key-pressed(event) => {
            if event.modifiers.control && (event.text == "c" || event.text == "C" || event.text == Key.Insert) {
                root.copy-selection(); return accept;
            }
            if event.modifiers.control && (event.text == "a" || event.text == "A") {
                root.select-all(); return accept;
            }
            if event.text == Key.Escape { root.selection-clear(); return accept; }
            if event.modifiers.shift {
                if event.text == Key.LeftArrow { root.selection-key("left"); return accept; }
                if event.text == Key.RightArrow { root.selection-key("right"); return accept; }
                if event.text == Key.UpArrow { root.selection-key("up"); return accept; }
                if event.text == Key.DownArrow { root.selection-key("down"); return accept; }
                if event.text == Key.Home { root.selection-key("home"); return accept; }
                if event.text == Key.End { root.selection-key("end"); return accept; }
            }
            return reject;
        }
        touch := TouchArea {
            mouse-cursor: text;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    keys.focus();
                    root.pressed-row = root.row-at-pointer();
                    root.pressed-column = root.column-at-pointer();
                    root.selection-start(root.pressed-row, root.pressed-column, event.modifiers.shift);
                    root.dragging = true;
                }
                if event.kind == PointerEventKind.cancel || (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                    root.dragging = false;
                    root.follow = !root.selected && list.content-y <= list.visible-height - list.content-height + 4px;
                }
            }
            moved => {
                if root.dragging && (root.row-at-pointer() != root.pressed-row || root.column-at-pointer() != root.pressed-column) {
                    root.selection-extend(root.row-at-pointer(), root.column-at-pointer());
                }
            }
            scroll-event(event) => {
                list.content-y = clamp(list.content-y + event.delta-y, min(0px, list.visible-height - list.content-height), 0px);
                list.content-x = clamp(list.content-x + event.delta-x, min(0px, list.visible-width - list.content-width), 0px);
                if root.dragging { root.selection-extend(root.row-at-pointer(), root.column-at-pointer()); }
                return accept;
            }
        }
        ContextMenuArea {
            Menu {
                MenuItem { title: "Copy"; enabled: root.selected; activated => { root.copy-selection(); } }
                MenuItem { title: "Select all"; activated => { keys.focus(); root.select-all(); } }
            }
        }
    }
    // A dedicated lane keeps the entire drag target outside text selection.
    horizontal-bar := Rectangle {
        visible: root.horizontal-overflow;
        y: list.height;
        width: list.visible-width;
        height: 20px;
        background: Theme.console-text.with-alpha(0.06);
        property <length> maximum: max(0px, list.content-width - list.visible-width);
        property <length> thumb-width: min(self.width, max(32px, self.width * list.visible-width / list.content-width));
        Rectangle {
            x: horizontal-bar.maximum > 0px ? -list.content-x / horizontal-bar.maximum * (parent.width - self.width) : 0px;
            y: 6px;
            height: 8px;
            width: horizontal-bar.thumb-width;
            border-radius: 4px;
            background: Theme.console-text.with-alpha(bar-touch.pressed ? 0.65 : bar-touch.has-hover ? 0.5 : 0.35);
        }
        bar-touch := TouchArea {
            property <length> start-x;
            property <length> start-offset;
            mouse-cursor: default;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    self.start-x = self.mouse-x;
                    self.start-offset = list.content-x;
                }
            }
            moved => {
                if self.pressed {
                    list.content-x = clamp(self.start-offset - (self.mouse-x - self.start-x)
                        * horizontal-bar.maximum / max(1px, horizontal-bar.width - horizontal-bar.thumb-width),
                        -horizontal-bar.maximum, 0px);
                }
            }
            scroll-event(event) => {
                list.content-x = clamp(list.content-x + event.delta-x + event.delta-y, -horizontal-bar.maximum, 0px);
                return accept;
            }
        }
    }
    Timer {
        interval: 40ms;
        running: root.dragging && (touch.mouse-y < 16px || touch.mouse-y > list.visible-height - 16px
            || touch.mouse-x < 0px || touch.mouse-x > list.visible-width);
        triggered => {
            if touch.mouse-y < 16px {
                list.content-y = min(0px, list.content-y + root.row-height);
            } else if touch.mouse-y > list.visible-height - 16px {
                list.content-y = max(min(0px, list.visible-height - list.content-height), list.content-y - root.row-height);
            }
            if touch.mouse-x < 0px { list.content-x = min(0px, list.content-x + root.char-width * 3); }
            else if touch.mouse-x > list.visible-width {
                list.content-x = max(min(0px, list.visible-width - list.content-width), list.content-x - root.char-width * 3);
            }
            root.selection-extend(root.row-at-pointer(), root.column-at-pointer());
        }
    }
}

// Content for Tooltip popups; the popup keeps it above surrounding UI and clipping.
export component TooltipContent inherits Rectangle {
    in property <string> text;
    border-radius: 4px;
    background: Theme.inverse-surface;
    min-height: 24px;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        Text {
            text: root.text;
            color: Theme.inverse-on-surface;
            font-size: Theme.label-medium;
            vertical-alignment: center;
        }
    }
}

// Active work spins; a running application has a steady lamp. Finished states use icons.
export component StatusBadge inherits Rectangle {
    in property <string> status;
    in property <length> size: 18px;
    in property <bool> agent;
    in property <bool> busy;
    in property <string> tooltip: status == "running" ? (busy ? "Working" : "Application running")
        : status == "success" ? "Succeeded (exit code 0)"
        : status == "failed" ? "Failed (nonzero exit code)"
        : status == "stopped" ? "Stopped" : status;
    in property <brush> busy-color: agent ? Theme.tertiary : Theme.primary;
    in property <brush> lamp-color: agent ? Theme.tertiary : Theme.success;
    in property <color> lamp-outline: Theme.surface;
    width: status == "" ? 0 : size;
    height: size;
    visible: status != "";

    accessible-role: text;
    accessible-label: tooltip;

    if status != "" && tooltip != "": Tooltip {
        TooltipContent { text: root.tooltip; }
    }

    if status == "running" && !busy: Rectangle {
        width: size * 0.6;
        height: self.width;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: self.width / 2;
        background: lamp-color;
        border-width: 1px;
        border-color: lamp-outline;
    }
    if status != "running" || busy: Image {
        width: size;
        height: size;
        source: status == "running" ? Icons.running
            : status == "success" ? Icons.success
            : status == "failed" ? Icons.failed
            : Icons.stopped;
        colorize: status == "running" ? busy-color
            : status == "success" ? Theme.success
            : status == "failed" ? Theme.error
            : Theme.outline;
        transform-rotation: status == "running" && busy ? mod(animation-tick() / 1.4ms, 360) * 1deg : 0deg;
    }
}

// An icon button with an M3 state layer. `style`: "standard", "tonal", "filled", "tertiary".
// The shape morphs from a circle to a rounded square while pressed (M3 Expressive).
// Native caption hit testing supplies hover/press for the Full maximize button.
export component CaptionButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> danger;
    in property <bool> window-active: true;
    in property <bool> native-input;
    in property <bool> hover;
    in property <bool> pressed;
    callback clicked();
    width: 46px;
    height: 36px;
    horizontal-stretch: 0;
    property <bool> highlighted: hover || touch.has-hover;
    background: danger && highlighted ? Theme.error
        : (pressed || touch.pressed) ? Theme.on-surface.with-alpha(0.12)
        : highlighted ? Theme.on-surface.with-alpha(0.08) : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }
    forward-focus: keys;
    Image {
        source: root.icon;
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: root.danger && root.highlighted ? Theme.on-error : Theme.on-surface-variant;
        opacity: root.window-active || root.highlighted ? 1 : 0.55;
    }
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: !root.native-input;
        clicked => { keys.focus(); root.clicked(); }
    }
}

export component TitleBar inherits Rectangle {
    in property <bool> window-active: true;
    in property <bool> maximized;
    in property <bool> max-hover;
    in property <bool> max-pressed;
    out property <length> drag-end: self.width - 138px;
    out property <length> max-button-x: self.width - 92px;
    callback minimize();
    callback maximize();
    callback close();
    height: 36px;
    background: Theme.surface-container;
    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            horizontal-stretch: 1;
            HorizontalLayout {
                padding-left: 12px;
                spacing: 8px;
                Image {
                    source: Icons.logo;
                    width: 18px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    opacity: root.window-active ? 1 : 0.55;
                }
                Text {
                    text: "RunBay";
                    color: Theme.on-surface-variant;
                    opacity: root.window-active ? 1 : 0.55;
                    font-size: Theme.label-medium;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }
        CaptionButton {
            icon: Icons.minimize; label: "Minimize";
            window-active: root.window-active;
            clicked => { root.minimize(); }
        }
        CaptionButton {
            icon: root.maximized ? Icons.restore : Icons.maximize;
            label: root.maximized ? "Restore" : "Maximize";
            window-active: root.window-active;
            native-input: true;
            hover: root.max-hover; pressed: root.max-pressed;
            clicked => { root.maximize(); }
        }
        CaptionButton {
            icon: Icons.close; label: "Close"; danger: true;
            window-active: root.window-active;
            clicked => { root.close(); }
        }
    }
}

export component SymbolButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> tooltip;
    in property <string> style: "standard";
    in property <bool> enabled: true;
    in property <bool> danger;
    in property <bool> window-active: true;
    in property <bool> active;
    in property <bool> agent;
    in property <string> status;
    in property <bool> busy;
    in property <length> size: 36px;
    in property <length> icon-size: 20px;
    // False for full-color images such as custom action icons.
    in property <bool> colorize-icon: true;
    in property <brush> icon-color: danger && touch.has-hover ? Theme.on-error : style == "filled" ? Theme.on-primary
        : style == "tertiary" ? Theme.on-tertiary
        : style == "tonal" ? Theme.on-secondary-container
        : Theme.on-surface-variant;
    // Plays the press animation without a click (used for runs started by agents).
    in property <bool> pulse;
    callback clicked();

    forward-focus: keys;
    property <bool> pressed: touch.pressed || pulse;
    width: label == "" ? size : size + label-text.preferred-width + 20px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    height: size;
    border-radius: pressed ? Theme.corner-small : self.height / 2;
    background: !enabled ? transparent
        : danger && touch.has-hover ? Theme.error
        : style == "filled" ? Theme.primary
        : style == "tertiary" ? Theme.tertiary
        : style == "tonal" ? Theme.secondary-container
        : transparent;
    opacity: !enabled ? 0.38 : window-active || touch.has-hover ? 1 : 0.55;
    animate border-radius { duration: Theme.motion-fast; easing: ease-out; }

    accessible-role: button;
    accessible-label: tooltip != "" ? tooltip : label;
    accessible-action-default => { if (enabled) { root.clicked(); } }

    state-layer := Rectangle {
        border-radius: parent.border-radius;
        background: Theme.on-surface;
        opacity: !enabled ? 0 : touch.pressed || keys.has-focus ? 0.12 : touch.has-hover ? 0.08 : 0;
        animate opacity { duration: Theme.motion-fast; }
    }

    HorizontalLayout {
        padding-left: label == "" ? 0px : 10px;
        padding-right: label == "" ? 0px : 12px;
        spacing: label == "" ? 0px : 6px;
        alignment: center;
        if root.status != "running": Image {
            source: icon;
            width: icon-size;
            height: icon-size;
            colorize: colorize-icon ? icon-color : transparent;
            y: (parent.height - self.height) / 2;
        }
        if root.status == "running": StatusBadge {
            tooltip: "";
            status: root.status;
            busy: root.busy;
            agent: root.agent;
            busy-color: root.icon-color;
            lamp-color: root.agent ? root.icon-color : Theme.success;
            lamp-outline: root.style == "filled" ? Theme.on-primary
                : root.style == "tertiary" ? Theme.on-tertiary : Theme.surface;
            size: root.icon-size;
            y: (parent.height - self.height) / 2;
        }
        if label != "": Text {
            text: root.label;
            color: root.icon-color;
            font-size: Theme.label-large;
            font-weight: 500;
            vertical-alignment: center;
        }
    }

    // Measure labeled buttons without leaving an empty layout item in icon buttons.
    label-text := Text {
        visible: false;
        text: root.label;
        font-size: Theme.label-large;
        font-weight: 500;
    }

    if agent: Rectangle {
        x: parent.width - 14px;
        y: -2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: Theme.tertiary-container;
        Image {
            source: Icons.agent;
            width: 12px;
            height: 12px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            colorize: Theme.on-tertiary-container;
        }
    }

    FocusRing {
        width: parent.width + 2 * self.offset;
        height: parent.height + 2 * self.offset;
        active: keys.has-focus;
        radius: root.border-radius;
    }
    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked(); return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    if tooltip != "": Tooltip {
        TooltipContent {
            text: root.tooltip;
        }
    }
}

// "by <agent>" chip for runs started by an MCP agent.
export component AgentChip inherits Rectangle {
    in property <string> agent;
    visible: agent != "";
    height: agent == "" ? 0 : 22px;
    width: agent == "" ? 0 : chip-layout.preferred-width;
    border-radius: 11px;
    background: Theme.tertiary-container;
    chip-layout := HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 4px;
        Image {
            source: Icons.agent;
            width: 14px;
            colorize: Theme.on-tertiary-container;
        }
        Text {
            text: "by " + agent;
            overflow: elide;
            min-width: 0px;
            color: Theme.on-tertiary-container;
            font-size: Theme.label-small;
            vertical-alignment: center;
        }
    }
}

// App icon, or the first letter of its name on a tonal circle.
export component Avatar inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon;
    in property <string> initial;
    in property <length> size: 32px;
    width: size;
    height: size;
    border-radius: size / 3;
    background: has-icon ? transparent : Theme.primary-container;
    if has-icon: Image {
        source: icon;
        width: size;
        height: size;
        image-fit: contain;
    }
    if !has-icon: Text {
        text: initial;
        color: Theme.on-primary-container;
        font-size: size * 0.5;
        font-weight: 600;
    }
}

// Console-only theme shortcut, shared by Full and Compact/Icon output headers.
export component ConsoleThemeButton inherits SymbolButton {
    icon: Theme.console-mode == 1 ? Icons.light-mode
        : Theme.console-mode == 2 ? Icons.dark-mode : Icons.system-theme;
    tooltip: Theme.console-mode == 1 ? "Console theme: Light. Click for Dark."
        : Theme.console-mode == 2 ? "Console theme: Dark. Click for Follow UI."
        : "Console theme: Follow UI. Click for Light.";
    size: 32px;
    clicked => { OutputBridge.cycle-console-theme(); }
}

// A modal scrim with a centered dialog surface; content goes inside.
export component DialogFrame inherits Rectangle {
    in property <string> title;
    in property <length> dialog-width: 420px;
    callback dismissed();
    background: #00000066;

    TouchArea {
        clicked => { root.dismissed(); }
    }

    surface := Rectangle {
        width: min(dialog-width, root.width - 32px);
        height: min(content.preferred-height, root.height - 32px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: Theme.corner-extra-large;
        background: Theme.surface-container-high;
        drop-shadow-blur: 24px;
        drop-shadow-color: #0000004d;
        // Swallow clicks so they do not reach the scrim.
        TouchArea { }
        content := VerticalLayout {
            padding: 24px;
            spacing: 16px;
            Text {
                text: title;
                font-size: Theme.title-large;
                color: Theme.on-surface;
                wrap: word-wrap;
            }
            @children
        }
    }
}

// A text button in M3 style ("text", "tonal", "filled").
export component PillButton inherits Rectangle {
    in property <string> text;
    in property <string> style: "text";
    in property <bool> enabled: true;
    callback clicked();
    forward-focus: keys;
    height: 40px;
    vertical-stretch: 0;
    min-width: label.preferred-width + 24px;
    border-radius: touch.pressed ? Theme.corner-small : 20px;
    animate border-radius { duration: Theme.motion-fast; easing: ease-out; }
    background: !enabled ? transparent
        : style == "filled" ? Theme.primary
        : style == "tonal" ? Theme.secondary-container
        : style == "danger" ? Theme.error
        : transparent;
    opacity: enabled ? 1 : 0.38;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { if (enabled) { root.clicked(); } }
    Rectangle {
        border-radius: parent.border-radius;
        background: Theme.on-surface;
        opacity: !enabled ? 0 : touch.pressed || keys.has-focus ? 0.12 : touch.has-hover ? 0.08 : 0;
    }
    label := Text {
        text: root.text;
        font-size: Theme.label-large;
        font-weight: 500;
        color: style == "filled" ? Theme.on-primary
            : style == "tonal" ? Theme.on-secondary-container
            : style == "danger" ? Theme.on-error
            : Theme.primary;
    }
    FocusRing {
        width: parent.width + 2 * self.offset;
        height: parent.height + 2 * self.offset;
        active: keys.has-focus;
        radius: root.border-radius;
    }
    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked(); return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Every action gets a direct icon until the available row width is exhausted.
export component ActionBar inherits Rectangle {
    in property <[ActionButton]> actions;
    in property <length> size: 32px;
    in property <string> style: "tonal";
    callback triggered(string);
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    height: actions.length == 0 ? 0px : size;
    property <length> gap: 4px;
    property <int> slots: max(1, floor((self.width + gap) / (size + gap)));
    property <int> direct-count: actions.length <= slots ? actions.length : max(0, slots - 1);

    for action[index] in actions: SymbolButton {
        visible: index < root.direct-count;
        x: index * (root.size + root.gap);
        icon: action.has-image ? action.image : Icons.action-icon(action.icon-name);
        colorize-icon: !action.has-image;
        tooltip: action.name;
        size: root.size;
        icon-size: 18px;
        enabled: action.enabled;
        style: action.status == "running" ? (action.agent ? "tertiary" : "filled") : root.style;
        agent: action.agent;
        status: action.status;
        busy: action.busy;
        pulse: action.agent && action.status == "running";
        clicked => { root.triggered(action.id); }
    }
    if root.direct-count < actions.length: SymbolButton {
        x: root.direct-count * (root.size + root.gap);
        icon: Icons.more-vert;
        tooltip: "More actions";
        size: root.size;
        icon-size: 18px;
        style: root.style;
        clicked => { overflow-menu.show(); }
    }
    overflow-menu := PopupWindow {
        x: max(0px, root.direct-count * (root.size + root.gap) - 180px);
        y: root.height;
        width: 220px;
        MenuSurface {
            dismissed => { overflow-menu.close(); }
            item-spacing: 0px;
            for action[index] in root.actions: Rectangle {
                height: index < root.direct-count ? 0px : index == root.actions.length - 1 ? 48px : 50px;
                visible: index >= root.direct-count;
                if index >= root.direct-count: MenuEntry {
                    first: index == root.direct-count;
                    last: index == root.actions.length - 1;
                    text: action.name;
                    icon: action.has-image ? action.image : Icons.action-icon(action.icon-name);
                    colorize-icon: !action.has-image;
                    enabled: action.enabled;
                    if action.status == "running": StatusBadge {
                        status: action.status;
                        busy: action.busy;
                        agent: action.agent;
                    }
                    // Dispatch before closing: closing destroys the popup's parent links.
                    clicked => { root.triggered(action.id); overflow-menu.close(); }
                }
            }
        }
    }
}

// Only this avatar can start an app reorder; the rest of the card stays interactive.
export component AppDragHandle inherits Avatar {
    in property <string> app-id;
    in property <string> group-id;
    in property <bool> draggable: true;
    TouchArea {
        enabled: root.draggable;
        mouse-cursor: self.pressed ? grabbing : grab;
        property <length> press-x;
        property <length> press-y;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                self.press-x = self.mouse-x;
                self.press-y = self.mouse-y;
            }
            if event.kind == PointerEventKind.cancel { AppDrag.cancel(); }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up { AppDrag.finish(); }
        }
        moved => {
            if self.pressed {
                if AppDrag.source == "" && (abs(self.mouse-y - self.press-y) > 6px || abs(self.mouse-x - self.press-x) > 6px) {
                    AppDrag.group = root.group-id;
                    AppDrag.source = root.app-id;
                }
                AppDrag.pointer-x = self.absolute-position.x + self.mouse-x;
                AppDrag.pointer-y = self.absolute-position.y + self.mouse-y;
            }
        }
    }
    Tooltip { TooltipContent { text: "Drag to reorder within group"; } }
}

// Visual drop position only; never covers the card's buttons or text.
export component AppDropIndicator inherits Rectangle {
    in property <string> app-id;
    in property <string> group-id;
    in property <bool> accepts-drop: true;
    property <bool> under-pointer: accepts-drop && AppDrag.source != "" && AppDrag.group == group-id
        && AppDrag.pointer-y >= AppDrag.viewport-top && AppDrag.pointer-y < AppDrag.viewport-bottom
        && AppDrag.pointer-x >= self.absolute-position.x && AppDrag.pointer-x < self.absolute-position.x + self.width
        && AppDrag.pointer-y >= self.absolute-position.y && AppDrag.pointer-y < self.absolute-position.y + self.height;
    property <bool> insert-after: AppDrag.pointer-y >= self.absolute-position.y + self.height / 2;
    changed under-pointer => {
        if under-pointer { AppDrag.target = app-id; AppDrag.after = insert-after; }
        else if AppDrag.target == app-id { AppDrag.target = ""; }
    }
    changed insert-after => {
        if under-pointer { AppDrag.target = app-id; AppDrag.after = insert-after; }
    }
    border-radius: Theme.corner-large;
    border-width: AppDrag.source == app-id ? 2px : 0px;
    border-color: Theme.primary;
    Rectangle {
        visible: AppDrag.source != "" && AppDrag.source != root.app-id && AppDrag.target == root.app-id;
        y: AppDrag.after ? parent.height - 3px : 0px;
        height: 3px;
        border-radius: 1.5px;
        background: Theme.primary;
    }
}
