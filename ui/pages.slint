// Full-mode pages: the app editor, settings, the Action History flyout, and dialogs.

import { TextEdit, CheckBox, ScrollView, ListView, AboutSlint } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { FilterChip, ConnectedButtonGroup, SegmentedList, ListItem, KeyboardRow, TextField, SymbolButton, StatusBadge, AgentChip, Avatar, DialogFrame, PillButton, ToggleSwitch, Dropdown, MenuSurface, MenuEntry } from "components.slint";

export struct EnvRow {
    key: string,
    value: string,
}

export struct EditorAction {
    id: string,
    name: string,
    kind: string,
    icon-name: string,
    image: image,
    has-image: bool,
    has-script: bool,
}

export struct HistoryRow {
    run-id: string,
    title: string,
    status: string,
    busy: bool,
    agent: string,
    time: string,
    duration: string,
    selected: bool,
}

export global EditorBridge {
    in-out property <bool> is-new;
    in-out property <image> icon;
    in-out property <bool> has-icon;
    in-out property <string> initial;
    in-out property <[string]> groups;
    in-out property <[EnvRow]> app-env;
    in-out property <[EditorAction]> actions;
    in-out property <int> selected-action;
    in-out property <[EnvRow]> action-env;
    in-out property <string> error;
    in-out property <string> name;
    in-out property <string> group;
    in-out property <string> working-directory;
    in-out property <int> shell-index;
    in-out property <string> action-name;
    in-out property <[string]> action-icon-options;
    in-out property <[string]> action-icon-names;
    in-out property <int> action-icon-index;
    in-out property <image> action-image;
    in-out property <bool> action-has-image;
    in-out property <string> script;
    in-out property <string> action-working-directory;
    in-out property <int> when-running-index;
    in-out property <int> retention-index;
    in-out property <string> retention-count;
    in-out property <bool> action-is-custom;
    in-out property <bool> action-has-script-file;
    in-out property <bool> action-is-build-run;
    callback cancel();
    callback save();
    callback choose-icon();
    callback remove-icon();
    callback choose-action-image();
    callback remove-action-image();
    callback choose-folder();
    callback app-env-edited(int, string, string);
    callback app-env-removed(int);
    callback app-env-added();
    callback select-action(int);
    in-out property <bool> can-add-build;
    in-out property <bool> can-add-run;
    in-out property <bool> can-add-build-run;
    callback add-action(string);
    callback move-action(int);
    callback remove-action();
    callback action-env-edited(int, string, string);
    callback action-env-removed(int);
    callback action-env-added();
    callback open-external();
    callback reload-script();
}

export global SettingsBridge {
    in-out property <int> theme-index;
    in-out property <int> console-theme-index;
    in-out property <bool> autostart;
    in-out property <int> icon-size-index;
    in-out property <bool> top-compact;
    in-out property <bool> top-icon;
    in-out property <bool> taskbar-full;
    in-out property <bool> taskbar-compact;
    in-out property <string> line-limit;
    in-out property <int> when-running-index;
    in-out property <int> retention-build;
    in-out property <string> count-build;
    in-out property <int> retention-run;
    in-out property <string> count-run;
    in-out property <int> retention-build-run;
    in-out property <string> count-build-run;
    in-out property <int> retention-custom;
    in-out property <string> count-custom;
    in-out property <bool> auto-update;
    in-out property <int> mcp-index;
    in-out property <string> update-status;
    in-out property <bool> data-custom;
    in-out property <string> data-hint;
    in-out property <bool> data-locked;
    callback changed();
    callback close();
    callback check-updates();
    callback data-custom-toggled();
    callback choose-data-folder();
    callback copy-mcp-setup();
}

export global HistoryBridge {
    in-out property <[HistoryRow]> rows;
    in-out property <[string]> app-filters;
    in-out property <[string]> action-filters;
    in-out property <int> app-filter;
    in-out property <int> action-filter;
    in-out property <int> status-filter;
    in-out property <int> source-filter;
    callback filters-changed();
    callback open-run(string);
    callback close();
}

component FieldLabel inherits Text {
    color: Theme.on-surface-variant;
    font-size: Theme.label-medium;
}

component SectionTitle inherits Text {
    color: Theme.primary;
    font-size: Theme.title-small;
    font-weight: 600;
}

// A key/value table for environment variables.
export component EnvTable inherits VerticalLayout {
    in property <[EnvRow]> rows;
    callback edited(int, string, string);
    callback removed(int);
    callback added();
    spacing: 6px;
    for row[index] in rows: HorizontalLayout {
        spacing: 6px;
        TextField {
            text: row.key;
            placeholder-text: "NAME";
            horizontal-stretch: 1;
            edited(text) => { root.edited(index, text, row.value); }
        }
        TextField {
            text: row.value;
            placeholder-text: "value";
            horizontal-stretch: 2;
            edited(text) => { root.edited(index, row.key, text); }
        }
        PillButton {
            text: "Remove";
            clicked => { root.removed(index); }
        }
    }
    HorizontalLayout {
        alignment: start;
        PillButton {
            text: "+ Add variable";
            clicked => { root.added(); }
        }
    }
}

export component EditorPage inherits Rectangle {
    in-out property <bool> is-new <=> EditorBridge.is-new;
    in-out property <image> icon <=> EditorBridge.icon;
    in-out property <bool> has-icon <=> EditorBridge.has-icon;
    in-out property <string> initial <=> EditorBridge.initial;
    in-out property <[string]> groups <=> EditorBridge.groups;
    in-out property <[EnvRow]> app-env <=> EditorBridge.app-env;
    in-out property <[EditorAction]> actions <=> EditorBridge.actions;
    in-out property <int> selected-action <=> EditorBridge.selected-action;
    in-out property <[EnvRow]> action-env <=> EditorBridge.action-env;
    in-out property <string> error <=> EditorBridge.error;
    in-out property <string> name <=> EditorBridge.name;
    in-out property <string> group <=> EditorBridge.group;
    in-out property <string> working-directory <=> EditorBridge.working-directory;
    in-out property <int> shell-index <=> EditorBridge.shell-index;
    in-out property <string> action-name <=> EditorBridge.action-name;
    in-out property <int> action-icon-index <=> EditorBridge.action-icon-index;
    in-out property <string> script <=> EditorBridge.script;
    in-out property <string> action-working-directory <=> EditorBridge.action-working-directory;
    in-out property <int> when-running-index <=> EditorBridge.when-running-index;
    in-out property <int> retention-index <=> EditorBridge.retention-index;
    in-out property <string> retention-count <=> EditorBridge.retention-count;
    in-out property <bool> action-is-custom <=> EditorBridge.action-is-custom;
    in-out property <bool> action-has-script-file <=> EditorBridge.action-has-script-file;
    in-out property <bool> action-is-build-run <=> EditorBridge.action-is-build-run;

    callback cancel();
    cancel() => { EditorBridge.cancel(); }
    callback save();
    save() => { EditorBridge.save(); }
    callback choose-icon();
    choose-icon() => { EditorBridge.choose-icon(); }
    callback remove-icon();
    remove-icon() => { EditorBridge.remove-icon(); }
    callback choose-folder();
    choose-folder() => { EditorBridge.choose-folder(); }
    callback app-env-edited(int, string, string);
    app-env-edited(a0, a1, a2) => { EditorBridge.app-env-edited(a0, a1, a2); }
    callback app-env-removed(int);
    app-env-removed(a0) => { EditorBridge.app-env-removed(a0); }
    callback app-env-added();
    app-env-added() => { EditorBridge.app-env-added(); }
    callback select-action(int);
    select-action(a0) => { EditorBridge.select-action(a0); }
    callback add-action(string);
    add-action(kind) => { EditorBridge.add-action(kind); }
    callback move-action(int);
    move-action(a0) => { EditorBridge.move-action(a0); }
    callback remove-action();
    remove-action() => { EditorBridge.remove-action(); }
    callback action-env-edited(int, string, string);
    action-env-edited(a0, a1, a2) => { EditorBridge.action-env-edited(a0, a1, a2); }
    callback action-env-removed(int);
    action-env-removed(a0) => { EditorBridge.action-env-removed(a0); }
    callback action-env-added();
    action-env-added() => { EditorBridge.action-env-added(); }
    callback open-external();
    open-external() => { EditorBridge.open-external(); }
    callback reload-script();
    reload-script() => { EditorBridge.reload-script(); }

    property <int> action-focus: -1;
    background: Theme.surface;
    // Swallow clicks so they do not reach the page below.
    TouchArea { }

    VerticalLayout {
        HorizontalLayout {
            padding: 16px;
            spacing: 8px;
            SymbolButton {
                icon: Icons.close;
                tooltip: "Cancel";
                clicked => { root.cancel(); }
            }
            Text {
                text: is-new ? "Add app" : "Edit " + name;
                font-size: Theme.title-large;
                color: Theme.on-surface;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if error != "": Text {
                text: error;
                color: Theme.error;
                vertical-alignment: center;
                overflow: elide;
                max-width: 420px;
            }
            PillButton {
                text: "Cancel";
                clicked => { root.cancel(); }
            }
            PillButton {
                text: "Save";
                style: "filled";
                clicked => { root.save(); }
            }
        }
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 16px;
            spacing: 16px;
            vertical-stretch: 1;

            // App fields.
            Rectangle {
                width: 340px;
                border-radius: Theme.corner-large;
                background: Theme.surface-container-low;
                ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        alignment: start;
                        SectionTitle { text: "App"; }
                        FieldLabel { text: "Name"; }
                        TextField {
                            text <=> name;
                            placeholder-text: "My App";
                        }
                        FieldLabel { text: "Group"; }
                        TextField {
                            text <=> group;
                            placeholder-text: groups.length > 0 ? "e.g. " + groups[0] : "Default";
                        }
                        FieldLabel { text: "Icon (png, ico, svg)"; }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Avatar {
                                icon: icon;
                                has-icon: has-icon;
                                initial: initial;
                                size: 40px;
                            }
                            PillButton {
                                text: "Choose…";
                                style: "tonal";
                                clicked => { root.choose-icon(); }
                            }
                            if has-icon: PillButton {
                                text: "Remove";
                                clicked => { root.remove-icon(); }
                            }
                        }
                        FieldLabel { text: "Working directory"; }
                        HorizontalLayout {
                            spacing: 6px;
                            TextField {
                                text <=> working-directory;
                                placeholder-text: "C:\\src\\my-app";
                            }
                            PillButton {
                                text: "Choose folder";
                                style: "tonal";
                                clicked => { root.choose-folder(); }
                            }
                        }
                        FieldLabel { text: "PowerShell"; }
                        Dropdown {
                            menu-width: max(self.width, 360px);
                            accessible-label: "PowerShell";
                            model: ["Auto (pwsh, then Windows PowerShell)", "PowerShell 7 (pwsh)", "Windows PowerShell 5.1"];
                            current-index <=> shell-index;
                        }
                        FieldLabel { text: "Environment variables"; }
                        EnvTable {
                            rows: app-env;
                            edited(i, k, v) => { root.app-env-edited(i, k, v); }
                            removed(i) => { root.app-env-removed(i); }
                            added => { root.app-env-added(); }
                        }
                    }
                }
            }

            // Actions.
            Rectangle {
                width: 200px;
                border-radius: Theme.corner-large;
                background: Theme.surface-container-low;
                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;
                    SectionTitle {
                        text: "Actions";
                        height: 32px;
                        vertical-alignment: center;
                    }
                    action-list := ListView {
                        vertical-stretch: 1;
                        for action[index] in actions: KeyboardRow {
                            accessible-label: action.name;
                            focus-request: root.action-focus == index;
                            activated => { root.select-action(index); }
                            moved(delta) => {
                                root.action-focus = clamp(index + delta, 0, root.actions.length - 1);
                                root.select-action(root.action-focus);
                            }
                            changed focus-request => {
                                if self.focus-request {
                                    if self.y + action-list.content-y < 0px { action-list.content-y = -self.y; }
                                    if self.y + self.height + action-list.content-y > action-list.visible-height {
                                        action-list.content-y = action-list.visible-height - self.y - self.height;
                                    }
                                }
                            }
                            height: 40px;
                            border-radius: 20px;
                            background: index == selected-action ? Theme.secondary-container
                                : action-touch.has-hover ? Theme.surface-container-high : transparent;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 8px;
                                spacing: 8px;
                                Image {
                                    source: action.has-image ? action.image : Icons.action-icon(action.icon-name);
                                    width: 18px;
                                    height: 18px;
                                    y: (parent.height - self.height) / 2;
                                    colorize: action.has-image ? transparent : Theme.on-surface-variant;
                                }
                                Text {
                                    text: action.name;
                                    color: Theme.on-surface;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                            action-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.select-action(index); }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 2px;
                        SymbolButton {
                            icon: Icons.add;
                            tooltip: "Add action";
                            size: 32px;
                            clicked => { add-action-menu.show(); }
                        }
                        SymbolButton {
                            icon: Icons.expand-more;
                            tooltip: "Move down";
                            size: 32px;
                            enabled: action-is-custom;
                            clicked => { root.move-action(1); }
                        }
                        SymbolButton {
                            icon: Icons.expand-more;
                            tooltip: "Move up";
                            size: 32px;
                            enabled: action-is-custom;
                            transform-rotation: 180deg;
                            clicked => { root.move-action(-1); }
                        }
                        SymbolButton {
                            icon: Icons.delete;
                            tooltip: "Remove action";
                            size: 32px;
                            enabled: actions.length > 0;
                            clicked => { root.remove-action(); }
                        }
                    }
                }
            }

            // Selected action.
            Rectangle {
                horizontal-stretch: 1;
                border-radius: Theme.corner-large;
                background: Theme.surface-container-low;
                if actions.length == 0: Text {
                    text: "No actions. Use Add action to choose a default or custom action.";
                    color: Theme.on-surface-variant;
                    wrap: word-wrap;
                }
                if actions.length > 0: ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        alignment: start;
                        SectionTitle { text: "Action"; }
                        FieldLabel { text: "Action name"; }
                        TextField { text <=> action-name; }
                        FieldLabel { text: "Action icon"; }
                        HorizontalLayout {
                            spacing: 8px;
                            Image {
                                source: EditorBridge.action-has-image ? EditorBridge.action-image
                                    : action-icon-index == 0
                                    ? Icons.default-action-icon(actions[selected-action].kind)
                                    : Icons.action-icon(EditorBridge.action-icon-names[action-icon-index]);
                                width: 24px;
                                height: 24px;
                                y: (parent.height - self.height) / 2;
                                colorize: EditorBridge.action-has-image ? transparent : Theme.on-surface-variant;
                            }
                            Dropdown {
                                accessible-label: "Action icon";
                                model: EditorBridge.action-icon-options;
                                current-index <=> action-icon-index;
                                enabled: !EditorBridge.action-has-image;
                                horizontal-stretch: 1;
                            }
                            PillButton {
                                text: "Image…";
                                style: "tonal";
                                clicked => { EditorBridge.choose-action-image(); }
                            }
                            if EditorBridge.action-has-image: PillButton {
                                text: "Remove image";
                                clicked => { EditorBridge.remove-action-image(); }
                            }
                        }
                        Text {
                            text: EditorBridge.action-has-image
                                ? "The image (png, ico, svg) replaces the symbol and keeps its own colors."
                                : "Pick a symbol, or use Image… for your own png, ico, or svg, such as an editor logo.";
                            color: Theme.on-surface-variant;
                            font-size: Theme.body-small;
                            wrap: word-wrap;
                        }
                        SectionTitle { text: "Script"; }
                        if !action-is-build-run: HorizontalLayout {
                            spacing: 8px;
                            FieldLabel {
                                text: "Script (PowerShell)";
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            PillButton {
                                text: "Open in external editor";
                                enabled: !is-new;
                                clicked => { root.open-external(); }
                            }
                            PillButton {
                                text: "Reload";
                                enabled: action-has-script-file;
                                clicked => { root.reload-script(); }
                            }
                        }
                        if !action-is-build-run: TextEdit {
                            text <=> script;
                            height: 260px;
                            font-size: Theme.mono-size;
                            wrap: no-wrap;
                        }
                        if action-is-build-run: Text {
                            text: "Build + Run runs the Build script, then the Run script when the build succeeded.";
                            color: Theme.on-surface-variant;
                            wrap: word-wrap;
                        }
                        SectionTitle { text: "Environment"; }
                        FieldLabel { text: "Environment overrides"; }
                        EnvTable {
                            rows: action-env;
                            edited(i, k, v) => { root.action-env-edited(i, k, v); }
                            removed(i) => { root.action-env-removed(i); }
                            added => { root.action-env-added(); }
                        }
                        SectionTitle { text: "Behavior"; }
                        FieldLabel { text: "Working directory (empty: the app's)"; }
                        TextField {
                            text <=> action-working-directory;
                            placeholder-text: working-directory;
                        }
                        FieldLabel { text: "When the app is still running"; }
                        Dropdown {
                            accessible-label: "When the app is still running";
                            model: ["Ask", "Reject", "Stop and restart", "Run in parallel"];
                            current-index <=> when-running-index;
                        }
                        FieldLabel { text: "History retention"; }
                        ConnectedButtonGroup {
                            labels: ["Off", "Last N", "Forever"];
                            selected-index <=> retention-index;
                        }
                        if retention-index == 1: HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            TextField { width: 80px; text <=> retention-count; input-type: number; }
                            Text { text: "runs"; color: Theme.on-surface-variant; font-size: Theme.body-small; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }
    add-action-menu := PopupWindow {
        x: 280px;
        y: max(0px, root.height - 210px);
        width: 210px;
        MenuSurface {
            dismissed => { add-action-menu.close(); }
            if EditorBridge.can-add-build: MenuEntry {
                first: true;
                text: "Build";
                icon: Icons.build;
                clicked => { root.add-action("build"); add-action-menu.close(); }
            }
            if EditorBridge.can-add-run: MenuEntry {
                first: !EditorBridge.can-add-build;
                text: "Run";
                icon: Icons.play;
                clicked => { root.add-action("run"); add-action-menu.close(); }
            }
            if EditorBridge.can-add-build-run: MenuEntry {
                first: !EditorBridge.can-add-build && !EditorBridge.can-add-run;
                text: "Build + Run";
                icon: Icons.rocket;
                clicked => { root.add-action("buildRun"); add-action-menu.close(); }
            }
            MenuEntry {
                first: !EditorBridge.can-add-build && !EditorBridge.can-add-run && !EditorBridge.can-add-build-run;
                last: true;
                text: "Custom action";
                icon: Icons.terminal;
                clicked => { root.add-action("custom"); add-action-menu.close(); }
            }
        }
    }

}

export component SettingsPage inherits Rectangle {
    in-out property <int> theme-index <=> SettingsBridge.theme-index;
    in-out property <int> console-theme-index <=> SettingsBridge.console-theme-index;
    in-out property <bool> autostart <=> SettingsBridge.autostart;
    in-out property <int> icon-size-index <=> SettingsBridge.icon-size-index;
    in-out property <bool> top-compact <=> SettingsBridge.top-compact;
    in-out property <bool> top-icon <=> SettingsBridge.top-icon;
    in-out property <bool> taskbar-full <=> SettingsBridge.taskbar-full;
    in-out property <bool> taskbar-compact <=> SettingsBridge.taskbar-compact;
    in-out property <string> line-limit <=> SettingsBridge.line-limit;
    in-out property <int> when-running-index <=> SettingsBridge.when-running-index;
    in-out property <int> retention-build <=> SettingsBridge.retention-build;
    in-out property <string> count-build <=> SettingsBridge.count-build;
    in-out property <int> retention-run <=> SettingsBridge.retention-run;
    in-out property <string> count-run <=> SettingsBridge.count-run;
    in-out property <int> retention-build-run <=> SettingsBridge.retention-build-run;
    in-out property <string> count-build-run <=> SettingsBridge.count-build-run;
    in-out property <int> retention-custom <=> SettingsBridge.retention-custom;
    in-out property <string> count-custom <=> SettingsBridge.count-custom;
    in-out property <bool> auto-update <=> SettingsBridge.auto-update;
    in-out property <int> mcp-index <=> SettingsBridge.mcp-index;
    in-out property <string> update-status <=> SettingsBridge.update-status;
    in-out property <bool> data-custom <=> SettingsBridge.data-custom;
    in-out property <string> data-hint <=> SettingsBridge.data-hint;
    in-out property <bool> data-locked <=> SettingsBridge.data-locked;
    callback changed();
    changed() => {
        SettingsBridge.changed();
    }
    callback close();
    close() => {
        SettingsBridge.close();
    }
    callback check-updates();
    check-updates() => {
        SettingsBridge.check-updates();
    }
    callback data-custom-toggled();
    data-custom-toggled() => {
        SettingsBridge.data-custom-toggled();
    }
    callback choose-data-folder();
    choose-data-folder() => {
        SettingsBridge.choose-data-folder();
    }
    property <int> category: 0;
    property <int> nav-focus: -1;
    property <[string]> categories: ["Appearance", "Startup & data", "Action defaults", "Updates", "Agents"];
    property <[image]> category-icons: [Icons.compact, Icons.folder, Icons.terminal, Icons.download, Icons.agent];
    property <[string]> descriptions: [
    "Choose how RunBay looks and behaves on your desktop.",
    "Choose when RunBay starts and where it keeps your apps and history.",
    "Defaults for newly created actions. Edit existing actions in the app editor.",
    "Manage automatic updates and check for a new version.",
    "Choose what connected coding agents may do in RunBay."
    ];
    background: Theme.surface;
    TouchArea {
    }
    VerticalLayout {
        padding: 20px;
        spacing: 20px;
        HorizontalLayout {
            spacing: 16px;
            PillButton {
                text: "Back";
                style: "tonal";
                clicked => {
                    root.close();
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: "Settings";
                    font-size: Theme.title-large;
                    font-weight: 600;
                    color: Theme.on-surface;
                }
                Text {
                    text: "Changes are saved automatically.";
                    font-size: Theme.body-small;
                    color: Theme.on-surface-variant;
                }
            }
        }
        HorizontalLayout {
            spacing: 16px;
            vertical-stretch: 1;
            Rectangle {
                width: 156px;
                Rectangle {
                    y: root.category * 52px;
                    height: 48px;
                    width: parent.width;
                    border-radius: Theme.corner-full;
                    background: Theme.secondary-container;
                    animate y {
                        duration: Theme.motion-fast;
                        easing: ease-out;
                    }
                }
                VerticalLayout {
                    spacing: 4px;
                    alignment: start;
                    for title[index] in root.categories: KeyboardRow {
                        height: 48px;
                        border-radius: Theme.corner-full;
                        focus-request: root.nav-focus == index;
                        activated => {
                            root.category = index;
                        }
                        moved(delta) => {
                            root.nav-focus = clamp(index + delta, 0, root.categories.length - 1);
                            root.category = root.nav-focus;
                        }
                        animate background {
                            duration: Theme.motion-fast;
                            easing: ease-out;
                        }
                        background: nav-touch.has-hover ? Theme.surface-container-high : transparent;
                        accessible-role: button;
                        accessible-label: title;
                        accessible-action-default => {
                            root.category = index;
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 8px;
                            spacing: 10px;
                            Image {
                                source: root.category-icons[index];
                                width: 20px;
                                height: 20px;
                                y: (parent.height - self.height) / 2;
                                colorize: root.category == index ? Theme.on-secondary-container : Theme.on-surface-variant;
                            }
                            Text {
                                text: title;
                                font-size: Theme.label-medium;
                                font-weight: root.category == index ? 600 : 400;
                                color: root.category == index ? Theme.on-secondary-container : Theme.on-surface-variant;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                        }
                        nav-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.category = index;
                            }
                        }
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.surface-container-low;
                border-radius: Theme.corner-large;
                settings-scroll := ScrollView {
                    content-width: self.visible-width;
                    VerticalLayout {
                        padding: 20px;
                        alignment: start;
                        HorizontalLayout {
                            alignment: start;
                            content := VerticalLayout {
                                width: min(720px, settings-scroll.visible-width - 40px);
                                horizontal-stretch: 1;
                                spacing: 16px;
                                alignment: start;
                                Text {
                                    text: root.categories[root.category];
                                    font-size: Theme.title-medium;
                                    font-weight: 600;
                                    color: Theme.on-surface;
                                }
                                Text {
                                    text: root.descriptions[root.category];
                                    color: Theme.on-surface-variant;
                                    font-size: Theme.body-medium;
                                    wrap: word-wrap;
                                }
                                if root.category == 0: VerticalLayout {
                                    spacing: 12px;
                                    alignment: start;
                                    SectionTitle {
                                        text: "Theme";
                                    }
                                    SegmentedList {
                                        ListItem {
                                            first: true;
                                            last: false;
                                            label: "Theme";
                                            Dropdown {
                                                accessible-label: "Theme";
                                                width: 200px;
                                                model: ["Follow Windows", "Light", "Dark"];
                                                current-index <=> theme-index;
                                                selected => {
                                                    root.changed();
                                                }
                                            }
                                        }
                                        ListItem {
                                            first: false;
                                            last: true;
                                            label: "Console theme";
                                            hint: "Only output views; Follow uses the theme selected for the UI.";
                                            Dropdown {
                                                accessible-label: "Console theme";
                                                width: 200px;
                                                model: ["Follow UI", "Light", "Dark"];
                                                current-index <=> console-theme-index;
                                                selected => {
                                                    root.changed();
                                                }
                                            }
                                        }
                                    }
                                    SectionTitle {
                                        text: "Floating window";
                                    }
                                    SegmentedList {
                                        ListItem {
                                            first: true;
                                            last: false;
                                            label: "Floating icon size";
                                            Dropdown {
                                                accessible-label: "Floating icon size";
                                                width: 200px;
                                                model: ["Small (40 px)", "Medium (56 px)", "Large (72 px)"];
                                                current-index <=> icon-size-index;
                                                selected => {
                                                    root.changed();
                                                }
                                            }
                                        }
                                        ListItem {
                                            first: false;
                                            last: false;
                                            label: "Always on top in Compact mode";
                                            ToggleSwitch {
                                                accessible-label: "Always on top in Compact mode";
                                                checked <=> top-compact;
                                                toggled => {
                                                    root.changed();
                                                }
                                            }
                                        }
                                        ListItem {
                                            first: false;
                                            last: true;
                                            label: "Always on top in Icon mode";
                                            ToggleSwitch {
                                                accessible-label: "Always on top in Icon mode";
                                                checked <=> top-icon;
                                                toggled => {
                                                    root.changed();
                                                }
                                            }
                                        }
                                    }
                                    SectionTitle {
                                        text: "Taskbar";
                                    }
                                    SegmentedList {
                                        ListItem {
                                            first: true;
                                            last: false;
                                            label: "Taskbar icon in Full mode";
                                            hint: "When off, use the tray icon to open RunBay.";
                                            ToggleSwitch {
                                                accessible-label: "Taskbar icon in Full mode";
                                                checked <=> taskbar-full;
                                                toggled => {
                                                    root.changed();
                                                }
                                            }
                                        }
                                        ListItem {
                                            first: false;
                                            last: true;
                                            label: "Taskbar icon in Compact mode";
                                            hint: "When off, use the tray icon to open RunBay.";
                                            ToggleSwitch {
                                                accessible-label: "Taskbar icon in Compact mode";
                                                checked <=> taskbar-compact;
                                                toggled => {
                                                    root.changed();
                                                }
                                            }
                                        }
                                    }
                                    SectionTitle {
                                        text: "Output";
                                    }
                                    SegmentedList {
                                        ListItem {
                                            first: true;
                                            last: true;
                                            label: "On-screen output line limit";
                                            hint: "Lines kept on screen per run; the log file stays complete.";
                                            TextField {
                                                width: 200px;
                                                text <=> line-limit;
                                                input-type: number;
                                                edited => {
                                                    root.changed();
                                                }
                                            }
                                        }
                                    }
                                }
                                if root.category == 1: VerticalLayout {
                                    spacing: 12px;
                                    alignment: start;
                                    SectionTitle {
                                        text: "Startup";
                                    }
                                    SegmentedList {
                                        ListItem {
                                            first: true;
                                            last: true;
                                            label: "Load with Windows";
                                            hint: "Starts RunBay at sign-in in the last mode and position.";
                                            ToggleSwitch {
                                                accessible-label: "Load with Windows";
                                                checked <=> autostart;
                                                toggled => {
                                                    root.changed();
                                                }
                                            }
                                        }
                                    }
                                    SectionTitle {
                                        text: "Data";
                                    }
                                    SegmentedList {
                                        ListItem {
                                            first: true;
                                            last: true;
                                            label: "Use another data folder";
                                            hint: data-hint;
                                            CheckBox {
                                                accessible-label: "Use another data folder";
                                                checked <=> data-custom;
                                                enabled: !data-locked;
                                                toggled => {
                                                    root.data-custom-toggled();
                                                }
                                            }
                                            PillButton {
                                                text: "Choose folder";
                                                style: "tonal";
                                                enabled: data-custom && !data-locked;
                                                clicked => {
                                                    root.choose-data-folder();
                                                }
                                            }
                                        }
                                    }
                                }
                                if root.category == 2: VerticalLayout {
                                    spacing: 12px;
                                    alignment: start;
                                    SectionTitle {
                                        text: "Running";
                                    }
                                    SegmentedList {
                                        ListItem {
                                            first: true;
                                            last: true;
                                            label: "When the app is still running";
                                            Dropdown {
                                                accessible-label: "Default when the app is still running";
                                                width: 200px;
                                                model: ["Ask", "Reject", "Stop and restart", "Run in parallel"];
                                                current-index <=> when-running-index;
                                                selected => {
                                                    root.changed();
                                                }
                                            }
                                        }
                                    }
                                    SectionTitle {
                                        text: "History retention";
                                    }
                                    SegmentedList {
                                        ListItem {
                                            first: true;
                                            last: false;
                                            label: "Build";
                                            VerticalLayout {
                                                spacing: 8px;
                                                ConnectedButtonGroup {
                                                    labels: ["Off", "Last N", "Forever"];
                                                    selected-index <=> retention-build;
                                                    selected => {
                                                        root.changed();
                                                    }
                                                }
                                                if retention-build == 1: HorizontalLayout {
                                                    alignment: start;
                                                    spacing: 8px;
                                                    TextField {
                                                        width: 80px;
                                                        text <=> count-build;
                                                        input-type: number;
                                                        edited => {
                                                            root.changed();
                                                        }
                                                    }
                                                    Text {
                                                        text: "runs";
                                                        color: Theme.on-surface-variant;
                                                        font-size: Theme.body-small;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                        ListItem {
                                            first: false;
                                            last: false;
                                            label: "Run";
                                            VerticalLayout {
                                                spacing: 8px;
                                                ConnectedButtonGroup {
                                                    labels: ["Off", "Last N", "Forever"];
                                                    selected-index <=> retention-run;
                                                    selected => {
                                                        root.changed();
                                                    }
                                                }
                                                if retention-run == 1: HorizontalLayout {
                                                    alignment: start;
                                                    spacing: 8px;
                                                    TextField {
                                                        width: 80px;
                                                        text <=> count-run;
                                                        input-type: number;
                                                        edited => {
                                                            root.changed();
                                                        }
                                                    }
                                                    Text {
                                                        text: "runs";
                                                        color: Theme.on-surface-variant;
                                                        font-size: Theme.body-small;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                        ListItem {
                                            first: false;
                                            last: false;
                                            label: "Build + Run";
                                            VerticalLayout {
                                                spacing: 8px;
                                                ConnectedButtonGroup {
                                                    labels: ["Off", "Last N", "Forever"];
                                                    selected-index <=> retention-build-run;
                                                    selected => {
                                                        root.changed();
                                                    }
                                                }
                                                if retention-build-run == 1: HorizontalLayout {
                                                    alignment: start;
                                                    spacing: 8px;
                                                    TextField {
                                                        width: 80px;
                                                        text <=> count-build-run;
                                                        input-type: number;
                                                        edited => {
                                                            root.changed();
                                                        }
                                                    }
                                                    Text {
                                                        text: "runs";
                                                        color: Theme.on-surface-variant;
                                                        font-size: Theme.body-small;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                        ListItem {
                                            first: false;
                                            last: true;
                                            label: "Custom";
                                            VerticalLayout {
                                                spacing: 8px;
                                                ConnectedButtonGroup {
                                                    labels: ["Off", "Last N", "Forever"];
                                                    selected-index <=> retention-custom;
                                                    selected => {
                                                        root.changed();
                                                    }
                                                }
                                                if retention-custom == 1: HorizontalLayout {
                                                    alignment: start;
                                                    spacing: 8px;
                                                    TextField {
                                                        width: 80px;
                                                        text <=> count-custom;
                                                        input-type: number;
                                                        edited => {
                                                            root.changed();
                                                        }
                                                    }
                                                    Text {
                                                        text: "runs";
                                                        color: Theme.on-surface-variant;
                                                        font-size: Theme.body-small;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if root.category == 3: VerticalLayout {
                                    spacing: 12px;
                                    alignment: start;
                                    SectionTitle {
                                        text: "Automatic updates";
                                    }
                                    SegmentedList {
                                        ListItem {
                                            first: true;
                                            last: true;
                                            label: "Update automatically";
                                            hint: update-status;
                                            ToggleSwitch {
                                                accessible-label: "Update automatically";
                                                checked <=> auto-update;
                                                toggled => {
                                                    root.changed();
                                                }
                                            }
                                        }
                                    }
                                    SectionTitle {
                                        text: "Manual check";
                                    }
                                    SegmentedList {
                                        ListItem {
                                            first: true;
                                            last: true;
                                            label: "Check for updates";
                                            PillButton {
                                                text: "Check now";
                                                style: "tonal";
                                                clicked => {
                                                    root.check-updates();
                                                }
                                            }
                                        }
                                    }
                                }
                                if root.category == 4: VerticalLayout {
                                    spacing: 12px;
                                    alignment: start;
                                    SectionTitle {
                                        text: "MCP access";
                                    }
                                    SegmentedList {
                                        ListItem {
                                            first: true;
                                            last: true;
                                            label: "MCP access";
                                            hint: mcp-index == 0 ? "Every agent request is refused." : mcp-index == 1 ? "Agents can read apps and runs. RunBay asks before an agent runs, stops, or changes anything." : "Agents can run, stop, and change apps and actions without asking.";
                                            Dropdown {
                                                accessible-label: "MCP access";
                                                width: 200px;
                                                model: ["Off", "Ask first", "Unrestricted"];
                                                current-index <=> mcp-index;
                                                selected => {
                                                    root.changed();
                                                }
                                            }
                                        }
                                    }
                                    SectionTitle {
                                        text: "Setup";
                                    }
                                    SegmentedList {
                                        ListItem {
                                            first: true;
                                            last: true;
                                            label: "MCP setup";
                                            hint: "Copy setup instructions to paste into your coding agent.";
                                            PillButton {
                                                text: "Copy MCP setup instructions";
                                                style: "tonal";
                                                clicked => {
                                                    SettingsBridge.copy-mcp-setup();
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
            }
        }
    }
}

export component HistoryFlyout inherits Rectangle {
    in-out property <[HistoryRow]> rows <=> HistoryBridge.rows;
    in-out property <[string]> app-filters <=> HistoryBridge.app-filters;
    in-out property <[string]> action-filters <=> HistoryBridge.action-filters;
    in-out property <int> app-filter <=> HistoryBridge.app-filter;
    in-out property <int> action-filter <=> HistoryBridge.action-filter;
    in-out property <int> status-filter <=> HistoryBridge.status-filter;
    in-out property <int> source-filter <=> HistoryBridge.source-filter;
    callback filters-changed();
    filters-changed() => { HistoryBridge.filters-changed(); }
    callback open-run(string);
    open-run(a0) => { HistoryBridge.open-run(a0); }
    callback close();
    close() => { HistoryBridge.close(); }

    property <int> row-focus: -1;
    background: Theme.surface-container-low;
    border-radius: Theme.corner-large;
    TouchArea { }

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            Text {
                text: "Action History";
                font-size: Theme.title-medium;
                font-weight: 600;
                color: Theme.on-surface;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            SymbolButton {
                icon: Icons.close;
                tooltip: "Close";
                clicked => { root.close(); }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            Dropdown {
                accessible-label: "Filter by app";
                model: app-filters;
                current-index <=> app-filter;
                selected => { root.filters-changed(); }
            }
            Dropdown {
                accessible-label: "Filter by action";
                model: action-filters;
                current-index <=> action-filter;
                selected => { root.filters-changed(); }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            for title[index] in ["Running", "Success", "Failed", "Stopped"]: FilterChip {
                text: title;
                selected: root.status-filter == index + 1;
                clicked => {
                    root.status-filter = root.status-filter == index + 1 ? 0 : index + 1;
                    root.filters-changed();
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            for title[index] in ["Clicks", "Agents"]: FilterChip {
                text: title;
                selected: root.source-filter == index + 1;
                clicked => {
                    root.source-filter = root.source-filter == index + 1 ? 0 : index + 1;
                    root.filters-changed();
                }
            }
        }
        if rows.length == 0: Text {
            text: "No runs.";
            color: Theme.on-surface-variant;
            horizontal-alignment: center;
        }
        history-list := ListView {
            vertical-stretch: 1;
            for row[index] in rows: KeyboardRow {
                focus-request: root.row-focus == index;
                accessible-label: row.title + " " + row.status;
                activated => { root.open-run(row.run-id); }
                moved(delta) => {
                    root.row-focus = clamp(index + delta, 0, root.rows.length - 1);
                    root.open-run(root.rows[root.row-focus].run-id);
                }
                changed focus-request => {
                    if self.focus-request {
                        if self.y + history-list.content-y < 0px { history-list.content-y = -self.y; }
                        if self.y + self.height + history-list.content-y > history-list.visible-height {
                            history-list.content-y = history-list.visible-height - self.y - self.height;
                        }
                    }
                }
                height: row-layout.preferred-height;
                border-radius: Theme.corner-medium;
                background: row.selected ? Theme.secondary-container
                    : row-touch.has-hover ? Theme.surface-container-high : transparent;
                row-layout := HorizontalLayout {
                    padding: 8px;
                    spacing: 10px;
                    StatusBadge {
                        status: row.status;
                        busy: row.busy;
                        agent: row.agent != "";
                        y: (parent.height - self.height) / 2;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: row.title;
                            color: Theme.on-surface;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Text {
                                text: row.time + (row.duration != "" ? " · " + row.duration : "");
                                color: Theme.on-surface-variant;
                                font-size: Theme.body-small;
                                vertical-alignment: center;
                            }
                            if row.agent != "": AgentChip { agent: row.agent; }
                        }
                    }
                }
                row-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-run(row.run-id); }
                }
            }
        }
    }
}

export component AboutDialog inherits DialogFrame {
    in property <string> version;
    in property <string> update-text;
    in property <bool> update-ready;
    callback notices();
    callback check-updates();
    callback release-notes();
    callback restart-update();
    callback skip-update();
    title: "About RunBay";
    dialog-width: 440px;
    HorizontalLayout {
        spacing: 16px;
        Image {
            source: Icons.logo;
            width: 56px;
            height: 56px;
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: "RunBay " + version;
                font-size: Theme.title-medium;
                font-weight: 600;
                color: Theme.on-surface;
            }
            Text {
                text: "Build and run your applications from one place. MIT license.";
                color: Theme.on-surface-variant;
                wrap: word-wrap;
            }
        }
    }
    if update-text != "": Text {
        text: update-text;
        color: Theme.tertiary;
        wrap: word-wrap;
    }
    if update-ready: HorizontalLayout {
        spacing: 8px;
        alignment: start;
        PillButton {
            text: "Restart to update";
            style: "filled";
            clicked => { root.restart-update(); }
        }
        PillButton {
            text: "Skip this version";
            clicked => { root.skip-update(); }
        }
        PillButton {
            text: "Release notes";
            clicked => { root.release-notes(); }
        }
    }
    AboutSlint {
        height: 140px;
    }
    Text {
        text: "Icons: Material Symbols Rounded by Google (Apache-2.0).";
        color: Theme.on-surface-variant;
        font-size: Theme.body-small;
        wrap: word-wrap;
    }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        PillButton {
            text: "Third-party notices";
            clicked => { root.notices(); }
        }
        PillButton {
            text: "Check for updates";
            clicked => { root.check-updates(); }
        }
        PillButton {
            text: "Close";
            style: "filled";
            clicked => { root.dismissed(); }
        }
    }
}
