// Full mode: navigation with apps, output panel, and dialogs.

import { ListView, LineEdit, TextEdit, Palette } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { ActionBar, SymbolButton, StatusBadge, AgentChip, Avatar, AppDragHandle, AppDropIndicator, DialogFrame, PillButton, TooltipContent, OutputView, ConsoleThemeButton, TitleBar } from "components.slint";
import { Span, OutputRow, ActionButton, RunRow, AppRow, Clock, AppDrag } from "types.slint";
import { EditorPage, SettingsPage, HistoryFlyout, AboutDialog } from "pages.slint";

component MenuItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> danger;
    callback clicked();
    height: 40px;
    background: touch.has-hover ? Theme.surface-container-highest : transparent;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 16px;
        spacing: 12px;
        Image {
            source: icon;
            width: 20px;
            colorize: danger ? Theme.error : Theme.on-surface-variant;
        }
        Text {
            text: root.text;
            color: danger ? Theme.error : Theme.on-surface;
            font-size: Theme.label-large;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Menu inherits Rectangle {
    border-radius: Theme.corner-small;
    background: Theme.surface-container;
    drop-shadow-blur: 8px;
    drop-shadow-color: #00000040;
    VerticalLayout {
        padding-top: 8px;
        padding-bottom: 8px;
        @children
    }
}

component AppCard inherits Rectangle {
    in property <AppRow> app;
    callback run-action(string, string);
    callback stop-app(string);
    callback select-run(string);
    callback edit-app(string);
    callback remove-app(string);
    callback open-working-directory(string);
    callback open-data-folder(string);
    callback move-app(string, int);

    border-radius: Theme.corner-large;
    background: Theme.surface-container-low;

    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        Rectangle {
            height: max(32px, header-labels.preferred-height);
            AppDragHandle {
                x: 0px;
                y: 0px;
                app-id: app.id;
                group-id: app.group-id;
                draggable: app.error == "";
                icon: app.icon;
                has-icon: app.has-icon;
                initial: app.initial;
                size: 32px;
            }
            header-labels := VerticalLayout {
                x: 42px;
                width: max(0px, header-status.x - self.x - 10px);
                height: parent.height;
                alignment: center;
                Text {
                    text: app.name;
                    font-size: Theme.title-small;
                    font-weight: 600;
                    color: Theme.on-surface;
                    overflow: elide;
                }
                if app.agent != "": AgentChip {
                    agent: app.agent;
                    width: min(parent.width, self.preferred-width);
                }
            }
            header-status := StatusBadge {
                x: menu-button.x - self.width - (self.width > 0px ? 10px : 0px);
                status: app.status;
                busy: app.status-busy;
                agent: app.status-agent;
                tooltip: app.status-detail;
                y: (parent.height - self.height) / 2;
            }
            menu-button := SymbolButton {
                x: parent.width - self.width;
                icon: Icons.more-vert;
                tooltip: "More";
                size: 32px;
                clicked => { app-menu.show(); }
            }
        }
        if app.error != "": Text {
            text: app.error;
            color: Theme.error;
            font-size: Theme.body-small;
            wrap: word-wrap;
        }
        if app.error == "": HorizontalLayout {
            spacing: 4px;
            alignment: stretch;
            ActionBar {
                actions: app.actions;
                size: 32px;
                style: "tonal";
                triggered(id) => { root.run-action(app.id, id); }
            }
            if app.status == "running": SymbolButton {
                icon: Icons.stop;
                tooltip: "Stop all active actions for " + app.name;
                size: 32px;
                icon-size: 18px;
                icon-color: Theme.error;
                clicked => { root.stop-app(app.id); }
            }
        }
        for run in app.runs: Rectangle {
            height: 28px;
            border-radius: Theme.corner-small;
            background: run.selected ? Theme.secondary-container
                : run-touch.has-hover ? Theme.surface-container-high : transparent;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                StatusBadge {
                    status: run.status;
                    busy: run.busy;
                    agent: run.agent != "";
                    size: 14px;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: run.title;
                    color: run.selected ? Theme.on-secondary-container : Theme.on-surface-variant;
                    font-size: Theme.body-small;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    property <string> elapsed: Clock.duration(run.status, run.started, run.duration);
                    text: elapsed == "" ? run.time : run.time + " · " + elapsed;
                    color: Theme.on-surface-variant;
                    font-size: Theme.label-small;
                    vertical-alignment: center;
                }
            }
            run-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.select-run(run.run-id); }
            }
        }
    }

    AppDropIndicator { app-id: app.id; group-id: app.group-id; accepts-drop: app.error == ""; }

    app-menu := PopupWindow {
        x: menu-button.x + menu-button.width - 220px;
        y: menu-button.y + menu-button.height;
        width: 220px;
        Menu {
            if app.error == "": MenuItem {
                text: "Edit";
                icon: Icons.edit;
                clicked => { root.edit-app(app.id); }
            }
            if app.error == "": MenuItem {
                text: "Open working directory";
                icon: Icons.folder-open;
                clicked => { root.open-working-directory(app.id); }
            }
            if app.error == "": MenuItem {
                text: "Move up";
                icon: Icons.expand-more;
                clicked => { root.move-app(app.id, -1); }
            }
            if app.error == "": MenuItem {
                text: "Move down";
                icon: Icons.expand-more;
                clicked => { root.move-app(app.id, 1); }
            }
            MenuItem {
                text: "Open app data folder";
                icon: Icons.folder;
                clicked => { root.open-data-folder(app.id); }
            }
            MenuItem {
                text: "Remove";
                icon: Icons.delete;
                danger: true;
                clicked => { root.remove-app(app.id); }
            }
        }
    }


}

export component MainWindow inherits Window {
    title: "RunBay";
    icon: @image-url("logo/runbay-64.png");
    preferred-width: 1100px;
    preferred-height: 700px;
    min-width: 640px;
    min-height: 436px;
    background: Theme.surface;
    default-font-size: Theme.body-medium;

    in property <bool> window-active: true;
    in property <bool> window-maximized;
    in property <bool> max-hover;
    in property <bool> max-pressed;
    out property <length> caption-height: 36px;
    out property <length> drag-end: caption.drag-end;
    out property <length> max-button-x: caption.max-button-x;
    out property <length> max-button-width: 46px;
    callback caption-minimize();
    callback caption-maximize();
    callback caption-close();
    callback caption-metrics-changed();
    changed caption-height => { root.caption-metrics-changed(); }
    changed drag-end => { root.caption-metrics-changed(); }
    changed max-button-x => { root.caption-metrics-changed(); }
    changed max-button-width => { root.caption-metrics-changed(); }

    in property <string> version;
    in property <int> theme-mode;
    in property <[AppRow]> apps;
    in property <[RunRow]> tabs;
    in property <[OutputRow]> output;
    in property <int> output-columns;
    in property <string> output-title;
    // Final duration of the displayed run, and its start in Clock seconds.
    in property <string> output-duration;
    in property <int> output-started;
    in property <string> output-status;
    in property <bool> output-busy;
    in property <string> output-agent;
    in property <string> output-run-id;
    in property <bool> output-has-log;
    in property <string> snackbar;
    in property <bool> snackbar-undo;
    // Names of the connected MCP agents, joined by ", ".
    in property <string> agents;

    // Agent confirmation dialog.
    in-out property <bool> agent-ask-visible;
    in property <string> agent-ask-agent;
    in property <string> agent-ask-operation;
    in property <bool> agent-ask-single;

    // "" (main view), "editor", or "settings".
    in-out property <string> page;
    in-out property <bool> history-open;
    // Keep the requested width while the window temporarily constrains the panels.
    private property <length> requested-navigation-width: 320px;
    private property <length> maximum-navigation-width: max(280px, root.width - history-panel.width - 288px);
    out property <length> navigation-panel-width: navigation.width;
    in-out property <bool> about-visible;
    in property <string> update-text;
    // Shown next to the version when an update is ready, e.g. "Update ready".
    in property <string> update-badge;
    in-out property <bool> exit-visible;
    in property <string> exit-text;
    in property <string> exit-title: "Exit RunBay?";
    in property <string> exit-button: "Stop all and exit";
    in property <bool> update-ready;

    // whenRunning "ask" dialog.
    in-out property <bool> ask-visible;
    in property <string> ask-text;

    // Remove confirmation.
    in-out property <bool> confirm-visible;
    in property <string> confirm-text;

    callback run-action(string, string);
    callback select-run(string);
    callback stop-run(string);
    callback stop-app(string);
    callback cycle-theme();
    callback copy-output();
    callback open-log();
    callback clear-output();
    callback add-app();
    callback edit-app(string);
    callback move-app(string, int);
    callback open-settings();
    callback toggle-history();
    callback about-notices();
    callback check-updates();
    callback exit-answer(string);
    callback switch-mode(string);
    callback restart-update();
    callback skip-update();
    callback release-notes();
    callback remove-app(string);
    callback confirm-remove();
    callback ask-answer(string);
    callback open-working-directory(string);
    callback open-data-folder(string);
    callback version-clicked();
    callback agent-ask-answer(string);
    callback undo-clicked();

    in property <int> output-generation;

    public function set-theme(mode: int) {
        Palette.color-scheme = mode == 1 ? ColorScheme.light : mode == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    public function scroll-to-end() {
        output-view.scroll-to-end();
    }

    HorizontalLayout {
        visible: root.page == "";
        y: root.caption-height;
        height: parent.height - root.caption-height;
        // Navigation.
        navigation := Rectangle {
            width: clamp(root.requested-navigation-width, 280px, root.maximum-navigation-width);
            background: Theme.surface-container;
            VerticalLayout {
                HorizontalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Image {
                        source: Icons.logo;
                        width: 28px;
                        height: 28px;
                    }
                    Text {
                        text: "RunBay";
                        font-size: Theme.title-large;
                        font-weight: 600;
                        color: Theme.on-surface;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    SymbolButton {
                        icon: theme-mode == 1 ? Icons.light-mode : theme-mode == 2 ? Icons.dark-mode : Icons.system-theme;
                        tooltip: theme-mode == 1 ? "Theme: Light. Click for Dark."
                            : theme-mode == 2 ? "Theme: Dark. Click for System."
                            : "Theme: System (" + (Theme.dark ? "Dark" : "Light") + "). Click for Light.";
                        size: 32px;
                        clicked => { root.cycle-theme(); }
                    }
                    if agents != "": Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: Theme.tertiary-container;
                        accessible-role: text;
                        accessible-label: "Connected agents: " + agents;
                        Image {
                            source: Icons.agent;
                            width: 18px;
                            colorize: Theme.on-tertiary-container;
                        }
                        Rectangle {
                            x: parent.width - 9px;
                            y: 1px;
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Theme.success;
                        }
                        Tooltip {
                            TooltipContent {
                                text: "Connected: " + root.agents;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-bottom: 8px;
                    spacing: 4px;
                    SymbolButton {
                        icon: Icons.history;
                        label: "Action History";
                        style: history-open ? "tonal" : "standard";
                        clicked => { root.toggle-history(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    SymbolButton {
                        icon: Icons.compact;
                        tooltip: "Compact mode";
                        clicked => { root.switch-mode("compact"); }
                    }
                    SymbolButton {
                        icon: Icons.bubble;
                        tooltip: "Icon mode";
                        clicked => { root.switch-mode("icon"); }
                    }
                    SymbolButton {
                        icon: Icons.settings;
                        tooltip: "Settings";
                        clicked => { root.open-settings(); }
                    }
                }
                app-list := ListView {
                    property <bool> dragging: AppDrag.source != "";
                    changed dragging => {
                        if self.dragging {
                            AppDrag.viewport-top = self.absolute-position.y;
                            AppDrag.viewport-bottom = self.absolute-position.y + self.visible-height;
                        }
                    }
                    vertical-stretch: 1;
                    for app in apps: VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-bottom: 8px;
                        spacing: 6px;
                        if app.group-header != "": Text {
                            text: app.group-header;
                            color: Theme.primary;
                            font-size: Theme.label-large;
                            font-weight: 600;
                            height: 28px;
                            vertical-alignment: bottom;
                        }
                        AppCard {
                            app: app;
                            run-action(a, b) => { root.run-action(a, b); }
                            stop-app(a) => { root.stop-app(a); }
                            select-run(r) => { root.select-run(r); }
                            edit-app(a) => { root.edit-app(a); }
                            remove-app(a) => { root.remove-app(a); }
                            open-working-directory(a) => { root.open-working-directory(a); }
                            open-data-folder(a) => { root.open-data-folder(a); }
                            move-app(a, d) => { root.move-app(a, d); }
                        }
                    }
                }
                Timer {
                    interval: 40ms;
                    running: AppDrag.source != "" && AppDrag.pointer-x >= app-list.absolute-position.x
                        && AppDrag.pointer-x < app-list.absolute-position.x + app-list.visible-width
                        && (AppDrag.pointer-y < app-list.absolute-position.y + 24px
                            || AppDrag.pointer-y > app-list.absolute-position.y + app-list.visible-height - 24px);
                    triggered => {
                        app-list.content-y = clamp(app-list.content-y + (AppDrag.pointer-y < app-list.absolute-position.y + 24px ? 12px : -12px),
                            min(0px, app-list.visible-height - app-list.content-height), 0px);
                    }
                }
                HorizontalLayout {
                    padding: 12px;
                    alignment: start;
                    SymbolButton {
                        icon: Icons.add;
                        label: "Add app";
                        style: "tonal";
                        size: 40px;
                        clicked => { root.add-app(); }
                    }
                }
                Rectangle {
                    height: 36px;
                    version-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.version-clicked(); }
                    }
                    HorizontalLayout {
                        padding-left: 16px;
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: "RunBay " + version;
                            color: version-touch.has-hover ? Theme.primary : Theme.on-surface-variant;
                            font-size: Theme.label-medium;
                            vertical-alignment: center;
                            accessible-role: text;
                        }
                        if update-badge != "": Rectangle {
                            y: (parent.height - self.height) / 2;
                            height: 22px;
                            width: badge-text.preferred-width + 16px;
                            border-radius: 11px;
                            background: Theme.tertiary-container;
                            badge-text := Text {
                                text: update-badge;
                                color: Theme.on-tertiary-container;
                                font-size: Theme.label-small;
                            }
                        }
                    }
                }
            }
        }

        // A wide hit target with a small visible grip between apps and output.
        splitter := Rectangle {
            width: 8px;
            background: Theme.surface-container;
            accessible-role: none;
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 2px;
                height: 32px;
                border-radius: 1px;
                background: splitter-touch.pressed || splitter-touch.has-hover ? Theme.primary : Theme.outline;
            }
            splitter-touch := TouchArea {
                private property <length> grab-offset;
                mouse-cursor: ew-resize;
                pointer-event(event) => {
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                        self.grab-offset = self.mouse-x;
                    }
                }
                moved => {
                    if self.pressed {
                        root.requested-navigation-width = clamp(splitter.x + self.mouse-x - self.grab-offset,
                            280px, root.maximum-navigation-width);
                    }
                }
            }
            Tooltip { TooltipContent { text: "Drag to resize app and console panels"; } }
        }

        // Output.
        VerticalLayout {
            horizontal-stretch: 1;
            if tabs.length > 1: HorizontalLayout {
                padding-left: 12px;
                padding-top: 8px;
                spacing: 4px;
                alignment: start;
                for tab in tabs: Rectangle {
                    height: 32px;
                    width: tab-layout.preferred-width;
                    border-radius: 16px;
                    background: tab.selected ? Theme.secondary-container
                        : tab-touch.has-hover ? Theme.surface-container-high : transparent;
                    tab-layout := HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 12px;
                        spacing: 6px;
                        StatusBadge {
                            status: tab.status;
                            busy: tab.busy;
                            agent: tab.agent != "";
                            size: 14px;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            property <string> elapsed: Clock.duration(tab.status, tab.started, tab.duration);
                            text: elapsed == "" ? tab.title : tab.title + " · " + elapsed;
                            font-size: Theme.label-medium;
                            color: tab.selected ? Theme.on-secondary-container : Theme.on-surface-variant;
                            vertical-alignment: center;
                        }
                        if tab.agent != "": AgentChip {
                            agent: tab.agent;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                    tab-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.select-run(tab.run-id); }
                    }
                }
            }
            HorizontalLayout {
                padding: 12px;
                padding-left: 16px;
                spacing: 10px;
                Text {
                    text: output-title == "" ? "No run selected" : output-title;
                    font-size: Theme.title-medium;
                    font-weight: 600;
                    color: Theme.on-surface;
                    vertical-alignment: center;
                    overflow: elide;
                }
                StatusBadge {
                    status: output-status;
                    busy: output-busy;
                    agent: output-agent != "";
                    y: (parent.height - self.height) / 2;
                }
                if Clock.duration(output-status, output-started, output-duration) != "": Text {
                    text: Clock.duration(output-status, output-started, output-duration);
                    font-size: Theme.label-large;
                    color: Theme.on-surface-variant;
                    vertical-alignment: center;
                }
                if output-agent != "": AgentChip {
                    agent: output-agent;
                    y: (parent.height - self.height) / 2;
                }
                Rectangle { horizontal-stretch: 1; }
                SymbolButton {
                    icon: Icons.stop;
                    label: "Stop";
                    style: "tonal";
                    enabled: output-status == "running";
                    clicked => { root.stop-run(output-run-id); }
                }
                SymbolButton {
                    icon: Icons.copy;
                    tooltip: "Copy all";
                    enabled: output.length > 0;
                    clicked => { root.copy-output(); }
                }
                ConsoleThemeButton { }
                SymbolButton {
                    icon: Icons.description;
                    tooltip: "Open log file";
                    enabled: output-has-log;
                    clicked => { root.open-log(); }
                }
                SymbolButton {
                    icon: Icons.clear-all;
                    tooltip: "Clear view";
                    enabled: output.length > 0;
                    clicked => { root.clear-output(); }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                background: Theme.console-background;
                border-radius: Theme.corner-large;
                clip: true;
                output-view := OutputView {
                    rows: root.output;
                    columns: root.output-columns;
                    generation: root.output-generation;
                }
            }
            Rectangle { height: 12px; }
        }
        history-panel := Rectangle {
            width: history-open ? 400px : 12px;
            animate width { duration: Theme.motion-medium; easing: ease-out-back; }
            clip: true;
            if history-open: HistoryFlyout {
                x: 12px;
                y: 12px;
                width: 376px;
                height: parent.height - 24px;
                close => { root.toggle-history(); }
            }
        }
    }

    // Snackbar.
    if snackbar != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 24px;
        width: min(snack-layout.preferred-width, parent.width - 48px);
        height: 48px;
        border-radius: Theme.corner-small;
        background: Theme.inverse-surface;
        snack-layout := HorizontalLayout {
            padding-left: 16px;
            padding-right: snackbar-undo ? 8px : 16px;
            spacing: 8px;
            Text {
                text: snackbar;
                color: Theme.inverse-on-surface;
                vertical-alignment: center;
                overflow: elide;
            }
            if snackbar-undo: Rectangle {
                width: undo-text.preferred-width + 24px;
                undo-text := Text {
                    text: "Undo";
                    color: Theme.inverse-primary;
                    font-weight: 600;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.undo-clicked(); }
                }
            }
        }
    }

    if page == "editor": EditorPage {
        y: root.caption-height;
        height: parent.height - root.caption-height;
    }

    if page == "settings": SettingsPage {
        y: root.caption-height;
        height: parent.height - root.caption-height;
        close => { root.page = ""; }
    }

    if ask-visible: DialogFrame {
        title: "The app is still running";
        dismissed => { root.ask-answer("cancel"); }
        Text {
            text: ask-text;
            color: Theme.on-surface-variant;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            PillButton {
                text: "Cancel";
                clicked => { root.ask-answer("cancel"); }
            }
            PillButton {
                text: "Run in parallel";
                style: "tonal";
                clicked => { root.ask-answer("parallel"); }
            }
            PillButton {
                text: "Stop and run";
                style: "filled";
                clicked => { root.ask-answer("restart"); }
            }
        }
    }

    if confirm-visible: DialogFrame {
        title: "Remove app?";
        dismissed => { confirm-visible = false; }
        Text {
            text: confirm-text;
            color: Theme.on-surface-variant;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            PillButton {
                text: "Cancel";
                clicked => { confirm-visible = false; }
            }
            PillButton {
                text: "Remove";
                style: "danger";
                clicked => { root.confirm-remove(); }
            }
        }
    }

    if agent-ask-visible: DialogFrame {
        title: agent-ask-agent + " asks RunBay to:";
        dialog-width: 480px;
        dismissed => { }
        HorizontalLayout {
            spacing: 12px;
            Image {
                source: Icons.agent;
                width: 24px;
                colorize: Theme.tertiary;
            }
            Text {
                text: agent-ask-operation;
                color: Theme.on-surface;
                font-size: Theme.body-large;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
        Text {
            text: "Without an answer within 2 minutes the request is denied.";
            color: Theme.on-surface-variant;
            font-size: Theme.body-small;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            PillButton {
                text: "Deny";
                clicked => { root.agent-ask-answer("deny"); }
            }
            if !agent-ask-single: PillButton {
                text: "Allow all until it disconnects";
                style: "tonal";
                clicked => { root.agent-ask-answer("all"); }
            }
            PillButton {
                text: "Allow";
                style: "filled";
                clicked => { root.agent-ask-answer("allow"); }
            }
        }
    }

    if about-visible: AboutDialog {
        version: version;
        update-text: update-text;
        dismissed => { root.about-visible = false; }
        notices => { root.about-notices(); }
        check-updates => { root.check-updates(); }
        update-ready: update-ready;
        restart-update => { root.restart-update(); }
        skip-update => { root.skip-update(); }
        release-notes => { root.release-notes(); }
    }

    if exit-visible: DialogFrame {
        title: exit-title;
        dismissed => { root.exit-answer("cancel"); }
        Text {
            text: exit-text;
            color: Theme.on-surface-variant;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            PillButton {
                text: "Cancel";
                clicked => { root.exit-answer("cancel"); }
            }
            PillButton {
                text: exit-button;
                style: "danger";
                clicked => { root.exit-answer("exit"); }
            }
        }
    }

    // Keep caption controls above page and dialog overlays, like native chrome.
    caption := TitleBar {
        x: 0px;
        y: 0px;
        width: parent.width;
        window-active: root.window-active;
        maximized: root.window-maximized;
        max-hover: root.max-hover;
        max-pressed: root.max-pressed;
        minimize => { root.caption-minimize(); }
        maximize => { root.caption-maximize(); }
        close => { root.caption-close(); }
    }
}
